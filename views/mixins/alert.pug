mixin alert-success(time)
    - if(messages.success)
        .message.info
            div(
                class="alert alert-success"
                show-alert
                data-time = time
                role="status"
            )
                .alert-icon(aria-hidden="true")
                    i.bi.bi-check-lg
                .alert-body
                    .alert-title Thành công
                    .alert-text #{messages.success}
                button.alert-close(type="button" close-alert aria-label="Đóng thông báo")
                    i.bi.bi-x-lg
                .alert-progress(style=`animation-duration:${time}ms`)

