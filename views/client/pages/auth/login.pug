include ../../../mixins/alert.pug

doctype html
html(lang="vi")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title Đăng nhập - SportZone
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(rel="stylesheet" href="/admin/css/style.css")
        link(rel="stylesheet" href="/css/login.css")
        link(rel="stylesheet", href="/css/style.css")


        +alert-error(5000)
        +alert-success(3000)

    body.sz-login-body
        main.sz-login
            //- ===== Cột trái: thương hiệu =====
            aside.sz-login-hero
                a.sz-brand(href="/")
                    span.sz-logo: i.bi.bi-calendar3
                    span.sz-brand-text
                        span.sz-brand-name
                            | Sport
                            span.text-green Zone
                            span.sz-pro PRO
                        span.sz-brand-sub Đặt sân nhanh · Quản lý gọn

                .sz-login-hero-body
                    h2 Đặt sân nhanh, quản lý sân gọn.
                    p Cầu lông, pickleball, bóng đá mini, tennis, bóng rổ — tất cả trong một tài khoản.

                    ul.sz-login-points
                        li
                            i.bi.bi-lightning-charge
                            span Xem lịch trống theo thời gian thực
                        li
                            i.bi.bi-wallet2
                            span Thanh toán bằng ví SportZone
                        li
                            i.bi.bi-shop
                            span Chủ sân quản lý sân và đơn đặt tại một nơi

                .sz-login-hero-foot
                    span.sz-dot-green
                    span Sẵn sàng nhận đặt sân 24/7

            //- ===== Cột phải: form =====
            section.sz-login-panel
                .sz-login-card
                    h1.sz-title Đăng nhập
                    p.sz-subtitle Nhập email và mật khẩu để tiếp tục.

                    form(action="/auth/login" method="POST" novalidate)
                        .sz-field
                            label(for="email") Email
                            .sz-input
                                i.bi.bi-envelope
                                input#email(
                                    type="email"
                                    name="email"
                                    placeholder="ten@email.com"
                                    value=email || ""
                                    autocomplete="email"
                                    required
                                    autofocus
                                )

                        .sz-field
                            .sz-field-row
                                label(for="password") Mật khẩu
                                a.sz-link(href="/auth/forgot-password") Quên mật khẩu?
                            .sz-input
                                i.bi.bi-lock
                                input#password(
                                    type="password"
                                    name="password"
                                    placeholder="Nhập mật khẩu"
                                    autocomplete="current-password"
                                    required
                                )
                                button.sz-eye(type="button" aria-label="Hiện mật khẩu" data-toggle-password="#password")
                                    i.bi.bi-eye

                        button.sz-btn-primary(type="submit") Đăng nhập

                    p.sz-login-alt
                        | Chưa có tài khoản?
                        a.sz-link(href="/auth/register")  Đăng ký

                p.sz-copy © 2026 SportZone

        script(src="/js/auth.js")
        script(src="/js/script.js") 