include ../../../mixins/alert.pug

doctype html
html(lang="vi")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title Đăng ký tài khoản - SportZone
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(rel="stylesheet" href="/admin/css/style.css")
        link(rel="stylesheet" href="/css/login.css")
        link(rel="stylesheet" href="/css/register.css")
        link(rel="stylesheet", href="/css/style.css")

        +alert-error(5000)
        +alert-success(3000)


    body.sz-login-body.sz-compact-body
        main.sz-login
            //- ===== Cột trái: thương hiệu & ưu điểm =====
            aside.sz-login-hero
                a.sz-brand(href="/")
                    span.sz-logo: i.bi.bi-calendar3
                    span.sz-brand-text
                        span.sz-brand-name
                            | Sport
                            span.text-green Zone
                            span.sz-pro PRO
                        span.sz-brand-sub Hệ thống Đặt &amp; Quản lý Sân

                .sz-login-hero-body
                    h2 Đặt sân nhanh, quản lý sân gọn.
                    p Cầu lông, pickleball, bóng đá mini, tennis, bóng rổ — tất cả trong một tài khoản.

                    ul.sz-login-points
                        li
                            i.bi.bi-lightning-charge
                            span Xem lịch trống theo thời gian thực
                        li
                            i.bi.bi-wallet2
                            span Thanh toán bằng ví SportZone
                        li
                            i.bi.bi-shop
                            span Chủ sân quản lý sân và đơn đặt tại một nơi

                .sz-login-hero-foot
                    span.sz-dot-green
                    span Sẵn sàng nhận đặt sân 24/7

            //- ===== Cột phải: form đăng ký gọn =====
            section.sz-login-panel
                .sz-login-card.sz-register-card
                    h1.sz-title Tạo tài khoản
                    p.sz-subtitle Điền thông tin bên dưới để bắt đầu sử dụng SportZone.

                    form(action="/auth/register" method="POST" novalidate)
                        //- Hàng 1: Họ tên + Số điện thoại (2 cột)
                        .sz-field-grid
                            .sz-field
                                label(for="fullName") Họ và tên
                                .sz-input
                                    i.bi.bi-person
                                    input#fullName(
                                        type="text"
                                        name="fullName"
                                        placeholder="Nguyễn Văn A"
                                        value=fullName || ""
                                        autocomplete="name"
                                        required
                                        autofocus
                                    )

                            .sz-field
                                label(for="phone") Số điện thoại
                                .sz-input
                                    i.bi.bi-telephone
                                    input#phone(
                                        type="tel"
                                        name="phone"
                                        placeholder="0901 234 567"
                                        value=phone || ""
                                        autocomplete="tel"
                                        required
                                    )

                        //- Hàng 2: Email (Toàn màn ngang)
                        .sz-field
                            label(for="email") Email
                            .sz-input
                                i.bi.bi-envelope
                                input#email(
                                    type="email"
                                    name="email"
                                    placeholder="ten@email.com"
                                    value=email || ""
                                    autocomplete="email"
                                    required
                                )

                        //- Hàng 3: Mật khẩu (Nằm trên)
                        .sz-field
                            label(for="password") Mật khẩu
                            .sz-input
                                i.bi.bi-lock
                                input#password(
                                    type="password"
                                    name="password"
                                    placeholder="Tối thiểu 8 ký tự"
                                    autocomplete="new-password"
                                    required
                                )
                                button.sz-eye(type="button" aria-label="Hiện mật khẩu" data-toggle-password="#password")
                                    i.bi.bi-eye

                        //- Hàng 4: Xác nhận mật khẩu (Nằm dưới)
                        .sz-field
                            label(for="confirmPassword") Xác nhận mật khẩu
                            .sz-input
                                i.bi.bi-shield-lock
                                input#confirmPassword(
                                    type="password"
                                    name="confirmPassword"
                                    placeholder="Nhập lại mật khẩu"
                                    autocomplete="new-password"
                                    required
                                )
                                button.sz-eye(type="button" aria-label="Hiện mật khẩu" data-toggle-password="#confirmPassword")
                                    i.bi.bi-eye

                        button.sz-btn-primary(type="submit") Đăng ký ngay

                    p.sz-login-alt
                        | Đã có tài khoản? 
                        a.sz-link(href="/auth/login") Đăng nhập

                p.sz-copy © 2026 SportZone

        script(src="/js/auth.js")
        script(src="/js/script.js") 