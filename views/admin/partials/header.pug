header.sz-header
  .sz-header-inner
    .d-flex.align-items-center.gap-4.flex-wrap
      a.sz-brand(href=panelHome || "/owner/dashboard")
        span.sz-logo: i.bi.bi-calendar3
        span
          span.sz-brand-name Sport
            span.text-green Zone
          small.sz-brand-sub Hệ thống Đặt & Quản lý Sân

    .d-flex.align-items-center.gap-3.gap-lg-4
      if panelRole === "admin"
        .sz-role-pill
          span.dot
          | Super Admin
        button.sz-bell(type="button" aria-label="Thông báo")
          i.bi.bi-bell
          span.sz-bell-dot
        .sz-user
          img(src="https://i.pravatar.cc/100?img=12" alt="Avatar admin")
          div
            .sz-user-name Lê Thanh Bình
            .sz-user-wallet Hệ thống
      else
        .sz-role-pill
          span.dot
          | Chủ sân
        button.sz-bell(type="button" aria-label="Thông báo")
          i.bi.bi-bell
          span.sz-bell-dot
        .sz-user
          img(src="https://i.pravatar.cc/100?img=5" alt="Avatar chủ sân")
          div
            .sz-user-name Trần Thu Hà
            .sz-user-wallet Ví: 14.250.000đ
