header.sz-header
  .sz-header-inner
    .d-flex.align-items-center.gap-4
      a.sz-brand(href="#")
        span.sz-logo: i.bi.bi-calendar3
        span
          span.sz-brand-name Sport
            span.text-green Zone
            span.sz-pro PRO
          small.sz-brand-sub Hệ thống Đặt & Quản lý Sân
      .sz-switch#roleSwitch
        button.sz-switch-btn(type="button" data-role="customer")
          i.bi.bi-person
          | Khách hàng (Đặt sân)
        button.sz-switch-btn.active(type="button" data-role="owner")
          i.bi.bi-buildings
          | Chủ sân & Quản trị
    .d-flex.align-items-center.gap-4
      .dropdown
        button.sz-role-pill.dropdown-toggle(type="button" data-bs-toggle="dropdown")
          span.dot
          i.bi.bi-shop
          | Chủ sân
          i.bi.bi-chevron-down.ms-1
        ul.dropdown-menu.dropdown-menu-end
          li: a.dropdown-item(href="#") Chủ sân
          li: a.dropdown-item(href="#") Quản lý
      button.sz-bell(type="button" aria-label="Thông báo")
        i.bi.bi-bell
        span.sz-bell-dot
      .sz-user
        img(src="https://i.pravatar.cc/100?img=12" alt="Avatar")
        div
          .sz-user-name Trần Văn Hoàng
          .sz-user-wallet Ví: 14.250.000đ
