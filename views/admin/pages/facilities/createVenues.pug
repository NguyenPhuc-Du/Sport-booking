extends ../../layouts/default.pug

block head
  link(rel="stylesheet" href="/admin/css/facilities.css")

block main
  .fv-modal-page
    .fv-modal
      .fv-modal-head
        h1.fv-modal-title Thêm cơ sở mới
        a.fv-modal-close(href=`${prefixAdmin}/facilities/venues` aria-label="Đóng")
          i.bi.bi-x-lg

      form.fv-modal-form#form-create-venue
        .fv-field
          label.fv-label(for="venueName")
            | Tên cơ sở
            span.fv-req *
          input#venueName.fv-input(
            type="text"
            name="name"
          )

        .fv-field
          label.fv-label(for="venueAddress")
            | Địa chỉ
            span.fv-req *
          input#venueAddress.fv-input(
            type="text"
            name="address"
          )

        .fv-field-row
          .fv-field
            label.fv-label(for="venueCity")
              | Tỉnh / Thành phố
              span.fv-req *
            .fv-select-wrap
              select#venueCity.fv-input.fv-select-field(name="city")
                option(value="") -- Chọn tỉnh / thành phố --
          .fv-field
            label.fv-label(for="venueWard")
              | Phường / Xã
              span.fv-req *
            .fv-select-wrap
              select#venueWard.fv-input.fv-select-field(
                name="district"
                disabled
              )
                option(value="") -- Chọn phường / xã --

        .fv-field-row
          .fv-field
            label.fv-label(for="openTime") Giờ mở cửa
            input#openTime.fv-input(
              type="time"
              name="open_time"
            )
          .fv-field
            label.fv-label(for="closeTime") Giờ đóng cửa
            input#closeTime.fv-input(
              type="time"
              name="close_time"
            )

        .fv-field
          label.fv-label(for="venueDescription") Mô tả
          textarea#venueDescription.fv-input.fv-textarea(
            name="description"
            rows="3"
            placeholder="Mô tả ngắn về cơ sở, tiện ích, loại sân..."
          )

        .fv-field-row
          .fv-field
            label.fv-label(for="venueStatus") Trạng thái
            .fv-select-wrap
              select#venueStatus.fv-input.fv-select-field(name="status")
                option(value="active" selected) Đang hoạt động
                option(value="inactive") Ngưng hoạt động
          .fv-field.fv-field-check
            label.fv-check
              input#isFeatured(
                type="checkbox"
                name="is_featured"
                value="true"
              )
              span Đánh dấu nổi bật (Featured)

        .fv-modal-foot
          a.fv-btn-cancel(href=`${prefixAdmin}/facilities/venues`) Hủy
          button.fv-btn-submit(type="submit") Lưu cơ sở

block script
  script(src="/admin/js/vn-address.js")