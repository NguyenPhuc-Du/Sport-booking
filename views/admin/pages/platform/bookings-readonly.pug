extends ../../../owner/layouts/default.pug
 
block main
  header.pf-head
    div
      p.pf-kicker Chỉ xem
      h1.pf-title Đơn đặt
      p.pf-sub Danh sách đơn trên toàn sàn. Trang này không sửa đơn.

  section.sz-card.sz-panel
    if !exists
      p.sz-empty Chưa có đơn đặt.
    else if items.length
      .table-responsive
        table.sz-table
          thead
            tr
              th Mã
              th Trạng thái
              th Thanh toán
          tbody
            each item in items
              tr
                td= item.code || "—"
                td= item.status || "—"
                td= item.payment_status || "—"
    else
      p.sz-empty Chưa có đơn đặt.

