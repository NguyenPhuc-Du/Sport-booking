extends ../../layouts/admin.pug
include ../../../mixins/alert.pug
include ../../../mixins/phan-trang.pug

block main
  +alert-success(4000)
  +alert-error(5000)
  if loai
    -
      const NHAN_TRUONG = { fullName: "Họ tên", email: "Email", phone: "Số điện thoại", createdAt: "Ngày tạo", thanhPho: "Thành phố", tinh: "Tỉnh/thành" }
      const NHAN_TOAN = { eq: "bằng", ne: "khác", contains: "chứa", gt: "lớn hơn", gte: "lớn hơn hoặc bằng", lt: "nhỏ hơn", lte: "nhỏ hơn hoặc bằng" }
      const MAU = ["#047857", "#0f766e", "#1d4ed8", "#7c3aed", "#b45309", "#be123c"]
      function mauTen(ten) {
        const chu = String(ten || "?")
        let n = 0
        for (let i = 0; i < chu.length; i += 1) n = (n + chu.charCodeAt(i)) % MAU.length
        return MAU[n]
      }
      function ngayVN(value) {
        if (!value) return { ngan: "—", du: "" }
        const date = new Date(value)
        if (Number.isNaN(date.getTime())) return { ngan: "—", du: "" }
        const parts = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Ho_Chi_Minh", day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(date)
        const lay = (type) => parts.find((part) => part.type === type).value
        const ngan = lay("day") + "/" + lay("month") + "/" + lay("year")
        return { ngan, du: lay("hour") + ":" + lay("minute") + ", " + ngan }
      }
      function queryLoc(doi) {
        const goc = { q: q || "", status: status || "", ky: ky || "", t1: t1 || "", o1: o1 || "", v1: v1 || "", l2: l2 || "", t2: t2 || "", o2: o2 || "", v2: v2 || "", sort: sort || "", dir: dir || "", pageSize: pageSize && String(pageSize) !== "10" ? String(pageSize) : "", page: page > 1 ? String(page) : "" }
        Object.assign(goc, doi || {})
        const params = new URLSearchParams()
        Object.keys(goc).forEach((key) => { if (goc[key]) params.set(key, goc[key]) })
        return params
      }
      function locUrl(doi) {
        const params = queryLoc(doi)
        const text = params.toString()
        return text ? basePath + "?" + text : basePath
      }
      function fileUrl(ten) {
        const text = queryLoc({}).toString()
        return basePath + "/" + ten + (text ? "?" + text : "")
      }
      const coLoc = Boolean(q || status || ky || v1 || v2)
      const dongLai = locUrl({})
    header.ad-page
      div
        p.ad-crumb Quản trị / #{title}
        h1= title
        p.ad-lead= moTa
      .ad-page-actions
        if can("user:create")
          a.ad-btn(href=`${basePath}/new`) + Thêm #{title.toLowerCase()}
        details.ad-export
          summary.ad-btn.is-ghost Xuất
          .ad-menu
            a(href=fileUrl("xuat-excel")) Xuất Excel
            a(href=fileUrl("xuat-pdf") target="_blank") Xuất PDF
        if can("user:create")
          button.ad-btn.is-ghost(type="button" data-open-import) Nhập Excel
    if stats
      .ad-kpis
        each the in stats
          - const bat = the.loc === "thang" ? ky === "thang" : the.loc ? status === the.loc && ky !== "thang" : !status && !ky
          a.ad-kpi(href=locUrl({ status: the.loc === "active" || the.loc === "inactive" ? the.loc : "", ky: the.loc === "thang" ? "thang" : "", page: "" }) class=bat ? "is-on" : "")
            i.bi(class=the.icon || "bi-people")
            span
              small= the.nhan
              strong= the.giaTri
              em= the.phu || ""
    form.ad-toolbar(method="get" action=basePath)
      label.ad-search
        i.bi.bi-search(aria-hidden="true")
        input#tim-khach(type="search" name="q" value=q placeholder="Tìm tên, email, số điện thoại" aria-label="Tìm tài khoản" autocomplete="off")
        kbd /
      select.ad-status(name="status" aria-label="Trạng thái" onchange="this.form.requestSubmit()")
        option(value="") Tất cả trạng thái
        option(value="active" selected=status === "active") Hoạt động
        option(value="inactive" selected=status === "inactive") Đã khóa
      if ky
        input(type="hidden" name="ky" value=ky)
      if sort
        input(type="hidden" name="sort" value=sort)
        input(type="hidden" name="dir" value=dir)
      if pageSize && String(pageSize) !== "10"
        input(type="hidden" name="pageSize" value=pageSize)
      details.ad-filter-pop
        summary.ad-btn.is-ghost
          i.bi.bi-funnel
          |  Bộ lọc nâng cao
        .ad-pop
          p Mỗi dòng là một điều kiện. Chọn Và, Hoặc hoặc Không giữa hai dòng.
          .ad-pop-row
            select(name="t1" aria-label="Trường thứ nhất")
              option(value="") Trường
              option(value="fullName" selected=t1 === "fullName") Họ tên
              option(value="email" selected=t1 === "email") Email
              option(value="phone" selected=t1 === "phone") Số điện thoại
              option(value="createdAt" selected=t1 === "createdAt") Ngày tạo
              if loai === "owners"
                option(value="thanhPho" selected=t1 === "thanhPho") Thành phố
              if loai === "customers"
                option(value="tinh" selected=t1 === "tinh") Tỉnh/thành
            select(name="o1" aria-label="Toán tử thứ nhất")
              option(value="contains" selected=!o1 || o1 === "contains") chứa
              option(value="eq" selected=o1 === "eq") bằng
              option(value="ne" selected=o1 === "ne") khác
              option(value="gt" selected=o1 === "gt") lớn hơn
              option(value="gte" selected=o1 === "gte") lớn hơn hoặc bằng
              option(value="lt" selected=o1 === "lt") nhỏ hơn
              option(value="lte" selected=o1 === "lte") nhỏ hơn hoặc bằng
            input(name="v1" value=v1 placeholder="Giá trị" aria-label="Giá trị thứ nhất")
          select.ad-join(name="l2" aria-label="Liên kết hai điều kiện")
            option(value="and" selected=l2 !== "or" && l2 !== "not") Và
            option(value="or" selected=l2 === "or") Hoặc
            option(value="not" selected=l2 === "not") Không
          .ad-pop-row
            select(name="t2" aria-label="Trường thứ hai")
              option(value="") Trường
              option(value="fullName" selected=t2 === "fullName") Họ tên
              option(value="email" selected=t2 === "email") Email
              option(value="phone" selected=t2 === "phone") Số điện thoại
              option(value="createdAt" selected=t2 === "createdAt") Ngày tạo
              if loai === "owners"
                option(value="thanhPho" selected=t2 === "thanhPho") Thành phố
              if loai === "customers"
                option(value="tinh" selected=t2 === "tinh") Tỉnh/thành
            select(name="o2" aria-label="Toán tử thứ hai")
              option(value="contains" selected=!o2 || o2 === "contains") chứa
              option(value="eq" selected=o2 === "eq") bằng
              option(value="ne" selected=o2 === "ne") khác
              option(value="gt" selected=o2 === "gt") lớn hơn
              option(value="gte" selected=o2 === "gte") lớn hơn hoặc bằng
              option(value="lt" selected=o2 === "lt") nhỏ hơn
              option(value="lte" selected=o2 === "lte") nhỏ hơn hoặc bằng
            input(name="v2" value=v2 placeholder="Giá trị" aria-label="Giá trị thứ hai")
          button.ad-btn(type="submit") Áp dụng
      button.ad-btn.is-ghost(type="submit") Lọc
    if loai === "customers"
      p.ad-lead
        a(href=locUrl({ t1: "tinh", o1: "eq", v1: "TP.HCM", l2: "or", t2: "tinh", o2: "eq", v2: "Hà Nội" })) Mẫu: khách ở TP.HCM hoặc Hà Nội
    if coLoc
      .ad-chips
        if q
          a.ad-chip(href=locUrl({ q: "" })) Tìm: #{q}
            span(aria-hidden="true") ×
        if status
          a.ad-chip(href=locUrl({ status: "" }))= status === "active" ? "Hoạt động" : "Đã khóa"
            span(aria-hidden="true") ×
        if ky === "thang"
          a.ad-chip(href=locUrl({ ky: "" })) Mới tháng này
            span(aria-hidden="true") ×
        if v1
          a.ad-chip(href=locUrl({ t1: "", o1: "", v1: "" })) #{NHAN_TRUONG[t1] || "Điều kiện"} #{NHAN_TOAN[o1] || ""} #{v1}
            span(aria-hidden="true") ×
        if v2
          a.ad-chip(href=locUrl({ t2: "", o2: "", v2: "", l2: "" })) #{l2 === "or" ? "Hoặc" : l2 === "not" ? "Không" : "Và"} #{NHAN_TRUONG[t2] || "Điều kiện"} #{NHAN_TOAN[o2] || ""} #{v2}
            span(aria-hidden="true") ×
        a.ad-chip.is-clear(href=basePath) Xóa tất cả
    if users.length
      .ad-table-wrap.ad-list
        table.ad-table
          thead
            tr
              th.ad-check-col
                input.ad-check(type="checkbox" data-check-all aria-label="Chọn tất cả dòng trên trang")
              th
                a.ad-sort(href=locUrl({ sort: "fullName", dir: sort === "fullName" && dir === "asc" ? "desc" : "asc" })) Tài khoản
                  if sort === "fullName"
                    i.bi(class=dir === "asc" ? "bi-caret-up-fill" : "bi-caret-down-fill")
              th.ad-col-phone Số điện thoại
              th.ad-col-role Vai trò
              th Trạng thái
              th
                a.ad-sort(href=locUrl({ sort: "createdAt", dir: sort === "createdAt" && dir === "asc" ? "desc" : "asc" })) Ngày tạo
                  if sort === "createdAt"
                    i.bi(class=dir === "asc" ? "bi-caret-up-fill" : "bi-caret-down-fill")
              th.ad-act-col
                span.ad-sr Hành động
          tbody
            each item in users
              - const href = `/admin/accounts/${loai}/${item._id}`
              - const passAction = `${href}/password`
              - const statusAction = `${href}/status`
              - const deleteAction = `${href}/delete`
              - const luc = ngayVN(item.createdAt)
              - const chu = item.fullName ? item.fullName.trim().charAt(0).toUpperCase() : "?"
              tr(data-href=String(item._id) === String(chon) ? locUrl({}) : locUrl({ chon: String(item._id) }) class=String(item._id) === String(chon) ? "is-chon" : "")
                td.ad-check-col
                  input.ad-check(type="checkbox" value=item._id aria-label=`Chọn ${item.fullName}`)
                td
                  a.ad-person(href=locUrl({ chon: String(item._id) }))
                    span.ad-avatar(style=`background:${mauTen(item.fullName)}`)= chu
                    span
                      strong= item.fullName
                      small= item.email
                td.ad-col-phone
                  span.ad-phone
                    = item.phone
                    button.ad-copy(type="button" data-copy=item.phone aria-label=`Sao chép số ${item.phone}`)
                      i.bi.bi-copy
                td.ad-col-role
                  span.ad-pill
                    i
                    = item.roleName || nhanVaiTro(item.roleCode || item.role)
                td
                  span.ad-pill(class=item.status === "active" ? "is-ok" : "is-off")
                    i
                    = nhanTrangThai(item.status)
                td(title=luc.du)= luc.ngan
                td.ad-row-actions
                  a.ad-icon-btn(href=href aria-label=`Xem ${item.fullName}`)
                    i.bi.bi-eye
                  if can("user:update")
                    a.ad-icon-btn(href=`${href}/edit` aria-label=`Sửa ${item.fullName}`)
                      i.bi.bi-pencil
                  details.ad-more
                    summary.ad-icon-btn(aria-label="Thêm thao tác")
                      i.bi.bi-three-dots
                    .ad-menu
                      if can("user:lock")
                        form(method="post" action=statusAction)
                          input(type="hidden" name="status" value=(item.status === "active" ? "inactive" : "active"))
                          input(type="hidden" name="next" value=locUrl({ chon: String(item._id) }))
                          button(type="submit")= item.status === "active" ? "Khóa" : "Mở khóa"
                      if can("user:reset_password")
                        button(type="button" data-open-pass data-action=passAction data-name=item.fullName data-next=locUrl({ chon: String(item._id) })) Đặt lại mật khẩu
                      if can("user:update")
                        button.ad-danger(type="button" data-open-delete data-action=deleteAction data-name=item.fullName data-next=dongLai) Xóa
      .ad-pager-row
        +phanTrang(pagination)
        label.ad-size Số dòng
          select(aria-label="Số dòng mỗi trang" data-page-size)
            option(value="10" selected=String(pageSize) === "10") 10
            option(value="20" selected=String(pageSize) === "20") 20
            option(value="50" selected=String(pageSize) === "50") 50
    else if coLoc
      .ad-empty
        i.bi.bi-search
        strong Không có kết quả phù hợp
        p Thử bỏ bớt điều kiện hoặc xóa bộ lọc.
        a.ad-btn.is-ghost(href=basePath) Xóa tất cả bộ lọc
    else
      .ad-empty
        i.bi.bi-people
        strong Chưa có #{title.toLowerCase()}
        p Tài khoản mới sẽ hiện ở đây sau khi được tạo.
        if can("user:create")
          a.ad-btn(href=`${basePath}/new`) + Thêm #{title.toLowerCase()}
    if loiPhu
      .ad-empty
        i.bi.bi-exclamation-circle
        strong= loiPhu
        a.ad-btn.is-ghost(href=dongLai) Thử lại
    if phu && phu.user
      a.ad-shade(href=dongLai aria-label="Đóng chi tiết")
      aside.ad-drawer(aria-label=`Chi tiết ${phu.user.fullName}`)
        header.ad-drawer-head
          span.ad-avatar.is-lg(style=`background:${mauTen(phu.user.fullName)}`)= phu.user.fullName ? phu.user.fullName.trim().charAt(0).toUpperCase() : "?"
          div
            h2= phu.user.fullName
            p= phu.user.email
          a.ad-icon-btn(href=dongLai aria-label="Đóng")
            i.bi.bi-x-lg
        .ad-drawer-actions
          a.ad-btn.is-ghost(href=`/admin/accounts/${loai}/${phu.user._id}`) Trang đầy đủ
          if can("user:update")
            a.ad-btn.is-ghost(href=`/admin/accounts/${loai}/${phu.user._id}/edit`) Sửa
          if can("user:lock")
            form(method="post" action=`/admin/accounts/${loai}/${phu.user._id}/status`)
              input(type="hidden" name="status" value=(phu.user.status === "active" ? "inactive" : "active"))
              input(type="hidden" name="next" value=locUrl({ chon: String(phu.user._id) }))
              button.ad-btn.is-ghost(type="submit")= phu.user.status === "active" ? "Khóa" : "Mở khóa"
        .ad-drawer-grid
          div
            span Số điện thoại
            strong= phu.user.phone
          div
            span Trạng thái
            strong= nhanTrangThai(phu.user.status)
          div
            span Ngày tạo
            strong= phu.hoSo && phu.hoSo.tao ? phu.hoSo.tao.chu : ngayVN(phu.user.createdAt).du
          div
            span Đăng nhập lần cuối
            strong= phu.hoSo && phu.hoSo.dangNhap ? phu.hoSo.dangNhap.chu : "Chưa đăng nhập bằng trang quản trị"
        if phu.hoSo && phu.hoSo.kpis
          .ad-kpis.is-tight
            each the in phu.hoSo.kpis
              article.ad-kpi
                i.bi(class=the.icon || "bi-bar-chart")
                span
                  small= the.nhan
                  strong= the.giaTri
                  em= the.phu || ""
        if phu.venues && phu.venues.length
          h3 Sân đang quản lý
          ul.ad-drawer-list
            each san in phu.venues
              li= san.name
        if phu.bookings
          h3 Lịch sử đặt sân
          if phu.bookings.length
            p.ad-lead Lần gần nhất: #{phu.bookings[0].facilityName} · #{phu.bookings[0].tien}
            .ad-table-wrap
              table.ad-table
                thead
                  tr
                    th Mã
                    th Sân
                    th.ad-num Tiền
                    th Trạng thái
                tbody
                  each don in phu.bookings
                    tr
                      td= don.code
                      td= don.facilityName
                      td.ad-num= don.tien
                      td= don.trangThai
          else
            p.ad-lead Chưa có lượt đặt sân.
    form.ad-bulk#hang-loat(method="post" action=`${basePath}/hang-loat` data-confirm="Áp dụng thao tác cho các dòng đã chọn?")
      input(type="hidden" name="next" value=dongLai)
      p Đã chọn
        strong(data-so-chon) 0
      if can("user:lock")
        button.ad-btn.is-ghost(type="submit" name="viec" value="khoa") Khóa
        button.ad-btn.is-ghost(type="submit" name="viec" value="mo") Mở khóa
      a.ad-btn.is-ghost(href=fileUrl("xuat-excel") data-bulk-export) Xuất đã chọn
      if can("user:update")
        button.ad-btn.is-danger(type="submit" name="viec" value="xoa") Xóa
    if can("user:create")
      dialog.ad-modal#modal-nhap
        form(method="post" action=`${basePath}/nhap-excel?_csrf=${csrfToken}` enctype="multipart/form-data")
          h2 Nhập Excel
          p Kéo file .xlsx vào đây. Cột: Họ tên, Email, Số điện thoại, Mật khẩu.
          a.ad-btn.is-ghost(href=`${basePath}/mau-excel`) Tải file mẫu
          label.ad-drop(data-drop)
            input(type="file" name="tep" accept=".xlsx" required)
            strong Kéo thả file hoặc bấm để chọn
            small(data-file-name) Chưa chọn file
          .ad-preview(data-preview hidden)
          .ad-modal-actions
            button.ad-btn.is-ghost(type="button" data-close-modal) Hủy
            button.ad-btn(type="submit") Nhập vào danh sách
  else
    header.ad-page
      div
        p.ad-crumb Hệ thống
        h1= title
      if showCreate && can("user:create")
        a.ad-btn(href="#tao-admin") Thêm quản trị viên
    nav.ad-tabs
      a.is-on(href="/admin/admins") Quản trị viên
      a(href="/admin/roles") Vai trò
    if showCreate && can("user:create")
      form.ad-form#tao-admin(method="post" action="/admin/admins")
        h2 Thêm quản trị viên
        label Họ và tên
          input(type="text" name="fullName" required maxlength="80")
        label Email
          input(type="email" name="email" required maxlength="120")
        label Số điện thoại
          input(type="tel" name="phone" required placeholder="0912345678")
        label Mật khẩu
          input(type="password" name="password" required minlength="6" autocomplete="new-password")
        label Vai trò
          select(name="role" required)
            each item in consoleRoles
              option(value=item.code)= item.label
        button.ad-btn(type="submit") Tạo quản trị viên
    form.ad-filters(method="get" action=basePath)
      input(type="search" name="q" value=q placeholder="Tên, email hoặc số điện thoại" aria-label="Tìm tài khoản")
      select(name="status" aria-label="Trạng thái")
        option(value="") Tất cả trạng thái
        option(value="active" selected=status === "active") Hoạt động
        option(value="inactive" selected=status === "inactive") Đã khóa
      button.ad-btn(type="submit") Lọc
      a.ad-btn.is-ghost(href=basePath) Xóa lọc
    if users.length
      .ad-table-wrap
        table.ad-table
          thead
            tr
              th Tài khoản
              th Số điện thoại
              th Vai trò
              th Trạng thái
              th Ngày tạo
              th
          tbody
            each item in users
              - const href = `/admin/users/${item._id}`
              - const passAction = `/admin/users/${item._id}/password`
              - const statusAction = `/admin/users/${item._id}/status`
              - const deleteAction = showCreate ? `/admin/admins/${item._id}/delete` : `/admin/users/${item._id}/delete`
              tr
                td
                  a.ad-person(href=href)
                    span.ad-avatar= item.fullName ? item.fullName.trim().charAt(0).toUpperCase() : "?"
                    span
                      strong= item.fullName
                      small= item.email
                td= item.phone
                td
                  span.ad-pill
                    i
                    = item.roleName || nhanVaiTro(item.roleCode || item.role)
                td
                  span.ad-pill(class=item.status === "active" ? "is-ok" : "is-off")
                    i
                    = nhanTrangThai(item.status)
                td= item.createdAt ? new Date(item.createdAt).toLocaleDateString("vi-VN", { timeZone: "Asia/Ho_Chi_Minh" }) : ""
                td.ad-actions
                  a.ad-btn.is-ghost(href=href) Xem
                  details.ad-more
                    summary(aria-label="Thêm thao tác") ⋯
                    .ad-menu
                      if can("user:lock")
                        form(method="post" action=statusAction)
                          input(type="hidden" name="status" value=(item.status === "active" ? "inactive" : "active"))
                          button(type="submit")= item.status === "active" ? "Khóa" : "Mở khóa"
                      if can("user:reset_password")
                        button(type="button" data-open-pass data-action=passAction data-name=item.fullName) Đặt lại mật khẩu
                      if showCreate && can("system:override")
                        form(method="post" action=deleteAction data-confirm=`Xóa ${item.fullName}?`)
                          button.ad-danger(type="submit") Xóa
      +phanTrang(pagination)
    else
      .ad-empty
        i.bi.bi-people
        strong Không có dữ liệu phù hợp

  dialog.ad-modal#modal-pass
    form(method="post" action="")
      h2 Đặt lại mật khẩu
      p(data-pass-name)
      label Mật khẩu mới
        input(type="password" name="password" required minlength="8" autocomplete="new-password")
      label Nhập lại mật khẩu
        input(type="password" name="confirm" required minlength="8" autocomplete="new-password")
      .ad-modal-actions
        button.ad-btn.is-ghost(type="button" data-toggle-pass) Hiện
        button.ad-btn.is-ghost(type="button" data-random-pass) Tạo ngẫu nhiên
        button.ad-btn.is-ghost(type="button" data-close-modal) Hủy
        button.ad-btn(type="submit") Lưu mật khẩu
  dialog.ad-modal#modal-delete
