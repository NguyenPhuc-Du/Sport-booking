extends ../../../owner/layouts/default.pug
include ../../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(5000)

  header.pf-head
    div
      p.pf-kicker Quản trị hệ thống / Vai trò
      h1.pf-title Vai trò & Phân quyền
    button.sz-btn.sz-btn-green(type="button" data-open="dialog-role") Thêm vai trò

  section.sz-card.sz-panel
    if roles.length
      .table-responsive
        table.sz-table
          thead
            tr
              th Tên
              th Mã
              th Mô tả
              th Số tài khoản
              th Loại
              th
          tbody
            each role in roles
              tr
                td
                  strong= role.name
                td= role.code
                td= role.description || "—"
                td= role.userCount
                td= role.kind
                td
                  a.sz-btn.sz-btn-sm(href=`/admin/roles/${role._id}`) Sửa quyền
    else
      .pf-empty
        strong Chưa có vai trò
        p Chạy script seed để có 4 vai trò mặc định.

  dialog.pf-dialog#dialog-role
    form(method="post" action="/admin/roles")
      .pf-dialog-head
        h2 Tạo vai trò tùy chỉnh
        button(type="button" data-close aria-label="Đóng") ×
      label Mã
      input.sz-input(type="text" name="code" required maxlength="40" placeholder="SUPPORT" pattern="[A-Za-z][A-Za-z0-9_]{1,40}")
      label Tên
      input.sz-input(type="text" name="name" required maxlength="80" placeholder="Hỗ trợ")
      label Mô tả
      textarea.sz-input(name="description" maxlength="300")
      .pf-dialog-actions
        button.sz-btn(type="button" data-close) Hủy
        button.sz-btn.sz-btn-green(type="submit") Tạo
