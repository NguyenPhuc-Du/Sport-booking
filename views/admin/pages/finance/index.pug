extends ../../layouts/default.pug
include ../../../mixins/alert.pug
block main
  +alert-success(5000)
  .vc-page
    .vc-head
      div
        h1.vc-title Tài chính, Đối soát &amp; Khuyến mãi
        p.vc-sub Quản trị chiến dịch mã ưu đãi, đối soát hoa hồng 5% và gói phần mềm SaaS
      a.vc-btn(href="#")
        i.bi.bi-download
        | Yêu cầu rút tiền (1.601.700đ)

    .vc-tabs
      a.vc-tab.active(href="#")
        i.bi.bi-ticket-perforated
        | Chiến dịch Voucher (3)
      a.vc-tab(href="#")
        i.bi.bi-credit-card-2-front
        | Đối soát &amp; Hoa hồng sàn (4)
      a.vc-tab(href="#")
        i.bi.bi-crown
        | Gói phần mềm SaaS

    .vc-card
      .vc-card-head
        div
          h2.vc-card-title Mã giảm giá đang kích hoạt
          p.vc-card-sub Kích cầu người chơi vào các khung giờ vàng hoặc tri ân hội viên
        a.vc-btn.vc-btn-sm(href=`${prefixAdmin}/finance/create`)
          i.bi.bi-plus-lg
          | Tạo Voucher mới

      .vc-table-wrap
        table.vc-table
          thead
            tr
              th Mã code
              th Chương trình
              th Mức giảm
              th Đơn tối thiểu
              th Đã dùng / Giới hạn
              th Thời hạn
              th Trạng thái
              th Hành động
          tbody
            for item in voucher
              tr
                td
                  span.vc-code #{item.code}
                td #{item.name}
                td
                  if(item.discount_type === "fixed")
                    span.vc-discount #{item.display_value}
                  else
                    span.vc-discount #{item.discount_value}%
                td #{item.display_minorder}
                td.vc-usage
                  span.vc-usage-text #{item.used_count}/#{item.quantity}
                  .vc-bar
                    .vc-bar-fill(style=`width: ${item.percentUsed}%`)
                td
                  span.vc-date #{item.start_date} - #{item.end_date}
                td
                  if(item.status=="active")
                    span.vc-status.cursor-btn hoạt động
                  else if(item.status=="expired")
                    span.vc-status.vc-status-muted.cursor-btn Hết lượt dùng
                  else
                    span.vc-status.vc-status-danger.cursor-btn Ngưng hoạt động
                td
                  .vc-actions
                    a.vc-btn-edit(
                      href=`${prefixAdmin}/finance/edit/${item._id}`
                    ) Sửa
                    button.vc-btn-del(
                      type="button"
                      button-delete
                      data-id=item._id
                    ) Xóa
    form(method='POST' action="" id="form-delete" data-path=`${prefixAdmin}/finance/delete`)
    script(src="/admin/js/finance.js")
    script(src="/js/script.js")
