extends ../../layouts/default.pug

block main
  .vc-page
    .vc-head
      div
        h1.vc-title Tài chính, Đối soát &amp; Khuyến mãi
        p.vc-sub Quản trị chiến dịch mã ưu đãi, đối soát hoa hồng 5% và gói phần mềm SaaS
      a.vc-btn(href="#")
        i.bi.bi-download
        | Yêu cầu rút tiền (1.601.700đ)

    .vc-tabs
      a.vc-tab.active(href="#")
        i.bi.bi-ticket-perforated
        | Chiến dịch Voucher (3)
      a.vc-tab(href="#")
        i.bi.bi-credit-card-2-front
        | Đối soát &amp; Hoa hồng sàn (4)
      a.vc-tab(href="#")
        i.bi.bi-crown
        | Gói phần mềm SaaS

    .vc-card
      .vc-card-head
        div
          h2.vc-card-title Mã giảm giá đang kích hoạt
          p.vc-card-sub Kích cầu người chơi vào các khung giờ vàng hoặc tri ân hội viên
        a.vc-btn.vc-btn-sm(href="#")
          i.bi.bi-plus-lg
          | Tạo Voucher mới

      .vc-table-wrap
        table.vc-table
          thead
            tr
              th Mã code
              th Chương trình
              th Mức giảm
              th Đơn tối thiểu
              th Đã dùng / Giới hạn
              th Thời hạn
              th Trạng thái
          tbody
            tr
              td
                span.vc-code SPORTNEW50
              td Giảm 50.000đ cho đơn đầu tiên
              td
                span.vc-discount 50.000đ
              td 200.000đ
              td.vc-usage
                span.vc-usage-text 168 / 500
                .vc-bar
                  .vc-bar-fill(style="width: 33.6%")
              td
                span.vc-date 2026-09-01 - 2026-10-31
              td
                span.vc-status Đang chạy
            tr
              td
                span.vc-code PEAKVIP10
              td Ưu đãi Giờ Vàng Giảm 10%
              td
                span.vc-discount 10%
              td 300.000đ
              td.vc-usage
                span.vc-usage-text 94 / 300
                .vc-bar
                  .vc-bar-fill(style="width: 31.3%")
              td
                span.vc-date 2026-09-10 - 2026-10-15
              td
                span.vc-status Đang chạy
