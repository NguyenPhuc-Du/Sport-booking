extends ../../layouts/default.pug

block script
  script(src="/admin/js/owner-profile.js")

block main
  .mb-4
    h1.sz-title Hồ sơ Chủ sân
    p.sz-subtitle Cập nhật ảnh đại diện và thông tin liên hệ hiển thị trên hệ thống SportZone.

  .sz-card.sz-panel
    form(action=`${prefixOwner}/profile/update` method="POST" enctype="multipart/form-data")
      .row.g-4
        .col-md-4
          .sz-avatar-editor
            img#ownerAvatarPreview(src=owner.avatar_url alt=owner.fullName)
            label.sz-btn.sz-btn-green.sz-btn-sm(for="ownerAvatarInput")
              i.bi.bi-camera
              | Đổi avatar
            input#ownerAvatarInput.d-none(type="file" name="avatar_url" accept="image/*")
            input#ownerAvatarUrl(type="hidden" name="avatar_url" value=owner.avatar_url || "")
            p.sz-muted.mt-2.mb-0 Tham gia #{owner.createdAt ? new Date(owner.createdAt).toLocaleDateString("vi-VN") : ""}
        .col-md-8
          .row.g-3
            .col-md-6
              label.sz-label Họ và tên
              input.sz-input(type="text" name="fullName" value=owner.fullName required)
            .col-md-6
              label.sz-label Số điện thoại
              input.sz-input(type="tel" name="phone" value=owner.phone required)
            .col-md-6
              label.sz-label Email
              input.sz-input(type="email" name="email" value=owner.email required)
            .col-12
              label.sz-label Cơ sở đang quản lý
              - const venueList = (typeof venues !== "undefined" ? venues : []).filter((v) => !v.deleted)
              if venueList.length
                .row.g-2
                  each v in venueList
                    - const place = [v.address, v.district, v.city].filter(Boolean).join(", ")
                    .col-12
                      .sz-court-card
                        .d-flex.justify-content-between.align-items-start.gap-2
                          div
                            strong.sz-court-name= v.name
                            p.sz-muted.mb-0.mt-1
                              i.bi.bi-geo-alt
                              |  #{place || "Chưa có địa chỉ"}
                            if v.open_time || v.close_time
                              p.sz-muted.mb-0
                                i.bi.bi-clock
                                |  #{v.open_time || "--:--"} - #{v.close_time || "--:--"}
                          if v.status === "inactive"
                            span.sz-badge.sz-badge-danger Ngừng hoạt động
                          else
                            span.sz-badge.sz-badge-ok Đang hoạt động
              else
                input.sz-input(type="text" value="Chưa quản lý cơ sở nào" readonly)
            .col-12
              label.sz-label Số dư ví
              input.sz-input(type="text" value=owner.wallet readonly)
            .col-12
              button.sz-btn.sz-btn-green(type="submit")
                i.bi.bi-save
                | Lưu hồ sơ chủ sân
