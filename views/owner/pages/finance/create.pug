extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block main
  +alert-error(5000)
  .vc-modal-page
    .vc-modal
      .vc-modal-head
        h1.vc-modal-title Tạo mã Voucher
        a.vc-modal-close(
          href=`${prefixAdmin}/finance/campaigns/${campaign._id}/vouchers`
          aria-label="Đóng"
        )
          i.bi.bi-x-lg

      form.vc-modal-form#form-create-voucher(
        action=`${prefixAdmin}/finance/create`
        method="POST"
      )
        input(type="hidden" name="campaign_id" value=campaign._id)
        input(type="hidden" name="owner_id" value=ownerId)

        .vc-field
          label.vc-label Chương trình
          input.vc-input(
            type="text"
            value=campaign.name
            disabled
          )
          small.sz-muted
            | Thời hạn: #{campaign.start_date_display} → #{campaign.end_date_display}
            |  · Cơ sở: #{campaign.venue_name}

        .vc-field
          label.vc-label(for="voucherCode")
            | Mã khuyến mãi (Code)
            span.vc-req *
          input#voucherCode.vc-input(
            type="text"
            name="code"
            placeholder="VÍ DỤ: SUMMER2026"
            required
          )

        .vc-field
          label.vc-label(for="voucherName")
            | Tiêu đề voucher
            span.vc-req *
          input#voucherName.vc-input(
            type="text"
            name="name"
            placeholder="Giảm 15% cho người chơi mới"
            required
          )

        .vc-field-row
          .vc-field
            label.vc-label(for="discountType")
              | Loại giảm giá
              span.vc-req *
            .vc-select-wrap
              select#discountType.vc-input.vc-select(name="discount_type" required)
                option(value="percent") Theo phần trăm (%)
                option(value="fixed") Số tiền cố định (VNĐ)
          .vc-field
            label.vc-label(for="discountValue")
              | Giá trị giảm
              span.vc-req *
            input#discountValue.vc-input(
              type="number"
              name="discount_value"
              value="15"
              min="0"
              required
            )

        .vc-field-row
          .vc-field
            label.vc-label(for="minOrder") Đơn tối thiểu (VNĐ)
            input#minOrder.vc-input(
              type="number"
              name="min_order_amount"
              value="150000"
              min="0"
            )
          .vc-field
            label.vc-label(for="maxDiscount") Giảm tối đa (VNĐ)
            input#maxDiscount.vc-input(
              type="number"
              name="max_discount"
              value="50000"
              min="0"
            )

        .vc-field
          label.vc-label(for="quantity")
            | Giới hạn số lượt dùng
            span.vc-req *
          input#quantity.vc-input(
            type="number"
            name="quantity"
            value="100"
            min="1"
            required
          )

        .vc-modal-foot
          a.vc-btn-cancel(href=`${prefixAdmin}/finance/campaigns/${campaign._id}/vouchers`) Hủy
          button.vc-btn-submit(type="submit") Phát hành Voucher
    script(src="/js/script.js")
