extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block main
  +alert-error(5000)
  .vc-modal-page
    .vc-modal
      .vc-modal-head
        h1.vc-modal-title Tạo mã Voucher
        a.vc-modal-close(
          href=`${prefixAdmin}/finance/campaigns/${campaign._id}/vouchers`
          aria-label="Đóng"
        )
          i.bi.bi-x-lg

      form.vc-modal-form#form-create-voucher(
        action=`${prefixAdmin}/finance/create`
        method="POST"
      )
        input(type="hidden" name="campaign_id" value=campaign._id)
        input(type="hidden" name="owner_id" value=ownerId)

        .vc-field
          label.vc-label Chương trình
          input.vc-input(type="text" value=campaign.name disabled)
          small.sz-muted
            | Thời hạn: #{campaign.start_date_display} → #{campaign.end_date_display}
            |  · Cơ sở: #{campaign.venue_name}

        .vc-field
          label.vc-label(for="voucherCode")
            | Mã khuyến mãi (Code)
            span.vc-req *
          input#voucherCode.vc-input(
            type="text"
            name="code"
            placeholder="VÍ DỤ: SUMMER2026"
            required
          )

        .vc-field
          label.vc-label(for="voucherName")
            | Tiêu đề voucher
            span.vc-req *
          input#voucherName.vc-input(
            type="text"
            name="name"
            placeholder="Giảm 15% cho người chơi mới"
            required
          )

        .vc-field-row
          .vc-field
            label.vc-label(for="applyScope")
              | Loại áp dụng
              span.vc-req *
            .vc-select-wrap
              select#applyScope.vc-input.vc-select(name="apply_scope" required)
                option(value="court" selected) Tiền sân
                option(value="drink") Đồ uống
                option(value="order") Hoá đơn (sân + nước)
          .vc-field
            label.vc-label(for="dayType") Ngày áp dụng
            .vc-select-wrap
              select#dayType.vc-input.vc-select(name="day_type")
                option(value="all" selected) Mọi ngày
                option(value="weekday") Thứ 2 – Thứ 6
                option(value="weekend") Thứ 7 & Chủ nhật

        .vc-field-row
          .vc-field
            label.vc-label(for="timeStart") Giờ bắt đầu (tuỳ chọn)
            input#timeStart.vc-input(type="time" name="time_start")
          .vc-field
            label.vc-label(for="timeEnd") Giờ kết thúc (tuỳ chọn)
            input#timeEnd.vc-input(type="time" name="time_end")

        .vc-field#productField(style="display:none")
          label.vc-label(for="productIds")
            | Sản phẩm đồ uống
            span.vc-req *
          select#productIds.vc-input(
            name="product_ids"
            multiple
            size="6"
            style="height:auto;padding:10px"
          )
            if drinks && drinks.length
              each d in drinks
                option(value=d._id)= `${d.name} (${d.price}đ)`
            else
              option(value="" disabled) Cơ sở chưa có đồ uống
          small.sz-muted Giữ Ctrl (Windows) hoặc Cmd (Mac) để chọn nhiều món

        .vc-field-row
          .vc-field
            label.vc-label(for="discountType")
              | Loại giảm giá
              span.vc-req *
            .vc-select-wrap
              select#discountType.vc-input.vc-select(name="discount_type" required)
                option(value="percent") Theo phần trăm (%)
                option(value="fixed") Số tiền cố định (VNĐ)
          .vc-field
            label.vc-label(for="discountValue")
              | Giá trị giảm
              span.vc-req *
            input#discountValue.vc-input(
              type="number"
              name="discount_value"
              value="15"
              min="0"
              required
            )

        .vc-field-row
          .vc-field
            label.vc-label(for="minOrder") Đơn tối thiểu (VNĐ)
            input#minOrder.vc-input(
              type="number"
              name="min_order_amount"
              value="0"
              min="0"
            )
          .vc-field
            label.vc-label(for="maxDiscount") Giảm tối đa (VNĐ)
            input#maxDiscount.vc-input(
              type="number"
              name="max_discount"
              value="50000"
              min="0"
            )

        .vc-field
          label.vc-label(for="quantity")
            | Giới hạn số lượt dùng
            span.vc-req *
          input#quantity.vc-input(
            type="number"
            name="quantity"
            value="100"
            min="1"
            required
          )

        .vc-modal-foot
          a.vc-btn-cancel(href=`${prefixAdmin}/finance/campaigns/${campaign._id}/vouchers`) Hủy
          button.vc-btn-submit(type="submit") Phát hành Voucher

    script.
      (function () {
        var scope = document.getElementById("applyScope");
        var field = document.getElementById("productField");
        function sync() {
          field.style.display = scope.value === "drink" ? "" : "none";
        }
        scope.addEventListener("change", sync);
        sync();
      })();
    script(src="/js/script.js")
