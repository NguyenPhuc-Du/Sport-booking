extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)
  .vc-modal-page
    .vc-modal
      .vc-modal-head
        h1.vc-modal-title Sửa mã Voucher
        a.vc-modal-close(
          href=campaign ? `${prefixAdmin}/finance/campaigns/${campaign._id}/vouchers` : `${prefixAdmin}/finance`
          aria-label="Đóng"
        )
          i.bi.bi-x-lg

      form.vc-modal-form#form-edit-voucher(
        action=`${prefixAdmin}/finance/edit/${voucher._id}?_method=PATCH`
        method="POST"
      )
        if campaign
          .vc-field
            label.vc-label Chương trình
            input.vc-input(type="text" value=campaign.name disabled)
            small.sz-muted
              | Thời hạn: #{campaign.start_date_display} → #{campaign.end_date_display}
              |  · Cơ sở: #{campaign.venue_name}

        .vc-field
          label.vc-label(for="voucherCode")
            | Mã khuyến mãi (Code)
            span.vc-req *
          input#voucherCode.vc-input(
            type="text"
            name="code"
            required
            value=voucher.code
          )

        .vc-field
          label.vc-label(for="voucherName")
            | Tiêu đề voucher
            span.vc-req *
          input#voucherName.vc-input(
            type="text"
            name="name"
            required
            value=voucher.name
          )

        .vc-field-row
          .vc-field
            label.vc-label(for="discountType")
              | Loại giảm giá
              span.vc-req *
            .vc-select-wrap
              select#discountType.vc-input.vc-select(name="discount_type" required)
                option(value="percent" selected=(voucher.discount_type === "percent")) Theo phần trăm (%)
                option(value="fixed" selected=(voucher.discount_type === "fixed")) Số tiền cố định (VNĐ)
          .vc-field
            label.vc-label(for="discountValue")
              | Giá trị giảm
              span.vc-req *
            input#discountValue.vc-input(
              type="number"
              name="discount_value"
              min="0"
              required
              value=voucher.discount_value
            )

        .vc-field-row
          .vc-field
            label.vc-label(for="minOrder") Đơn tối thiểu (VNĐ)
            input#minOrder.vc-input(
              type="number"
              name="min_order_amount"
              min="0"
              value=voucher.min_order_amount
            )
          .vc-field
            label.vc-label(for="maxDiscount") Giảm tối đa (VNĐ)
            input#maxDiscount.vc-input(
              type="number"
              name="max_discount"
              min="0"
              value=voucher.max_discount
            )

        .vc-field
          label.vc-label(for="quantity")
            | Giới hạn số lượt dùng
            span.vc-req *
          input#quantity.vc-input(
            type="number"
            name="quantity"
            min="1"
            required
            value=voucher.quantity
          )

        .vc-field
          label.vc-label(for="status") Trạng thái
          .vc-select-wrap
            select#status.vc-input.vc-select(name="status")
              option(value="active" selected=(voucher.status === "active")) Đang hoạt động
              option(value="inactive" selected=(voucher.status === "inactive")) Ngưng hoạt động
              option(value="expired" selected=(voucher.status === "expired")) Hết hạn

        .vc-modal-foot
          a.vc-btn-cancel(
            href=campaign ? `${prefixAdmin}/finance/campaigns/${campaign._id}/vouchers` : `${prefixAdmin}/finance`
          ) Hủy
          button.vc-btn-submit(type="submit") Lưu
    script(src="/js/script.js")
