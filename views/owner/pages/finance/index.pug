extends ../../layouts/default.pug
include ../../../mixins/alert.pug
include ../../../mixins/pagination.pug

block main
  +alert-success(5000)
  +alert-error(5000)
  .vc-page
    .vc-head
      div
        h1.vc-title Chương trình khuyến mãi
        p.vc-sub Quản lý chiến dịch theo thời gian sự kiện và các mã voucher con bên trong
      a.vc-btn.vc-btn-sm(href=`${prefixAdmin}/finance/campaigns/create`)
        i.bi.bi-plus-lg
        | Tạo chương trình

    .vc-card
      .vc-card-head
        div
          h2.vc-card-title Danh sách chương trình
          p.vc-card-sub Mỗi chương trình có thời hạn riêng và chứa nhiều voucher con

      .vc-table-wrap
        table.vc-table
          thead
            tr
              th Tên chương trình
              th Cơ sở
              th Thời hạn
              th Số voucher
              th Trạng thái
              th Hành động
          tbody
            if campaigns && campaigns.length
              each item in campaigns
                tr
                  td
                    strong #{item.name}
                    if item.description
                      .sz-muted #{item.description}
                  td #{item.venue_name}
                  td
                    span.vc-date #{item.start_date_display} → #{item.end_date_display}
                  td #{item.voucher_count}
                  td
                    if item.status == "active"
                      span.vc-status hoạt động
                    else if item.status == "expired"
                      span.vc-status.vc-status-muted hết hạn
                    else
                      span.vc-status.vc-status-danger ngưng
                  td
                    .vc-actions
                      a.vc-btn-edit(
                        href=`${prefixAdmin}/finance/campaigns/${item._id}/vouchers`
                      ) Voucher
                      a.vc-btn-edit(
                        href=`${prefixAdmin}/finance/campaigns/edit/${item._id}`
                      ) Sửa
                      button.vc-btn-del(
                        type="button"
                        button-delete
                        data-id=item._id
                      ) Xóa
            else
              tr
                td.vc-empty(colspan="6") Không có chương trình khuyến mãi

      nav.vc-pagination(aria-label="Phân trang chương trình")
        +pagination(pagination)

    form(
      method="POST"
      action=""
      id="form-delete"
      data-path=`${prefixAdmin}/finance/campaigns/delete`
    )
    script(src="/admin/js/finance.js")
    script(src="/js/script.js")
