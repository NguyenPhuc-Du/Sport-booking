extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)
  .vc-modal-page
    .vc-modal
      .vc-modal-head
        h1.vc-modal-title Sửa chương trình khuyến mãi
        a.vc-modal-close(href=`${prefixAdmin}/finance` aria-label="Đóng")
          i.bi.bi-x-lg

      form.vc-modal-form(
        action=`${prefixAdmin}/finance/campaigns/edit/${campaign._id}?_method=PATCH`
        method="POST"
      )
        .vc-field
          label.vc-label(for="campaignName")
            | Tên chương trình
            span.vc-req *
          input#campaignName.vc-input(
            type="text"
            name="name"
            value=campaign.name
            required
          )

        .vc-field
          label.vc-label(for="campaignDesc") Mô tả
          textarea#campaignDesc.vc-input(
            name="description"
            rows="3"
          )= campaign.description || ""

        .vc-field
          label.vc-label(for="venueId")
            | Cơ sở áp dụng
            span.vc-req *
          .vc-select-wrap
            select#venueId.vc-input.vc-select(name="venue_id" required)
              option(value="" disabled) -- Chọn cơ sở --
              each item in venues
                option(
                  value=item._id
                  selected=(String(item._id) === String(campaign.venue_id && campaign.venue_id._id ? campaign.venue_id._id : campaign.venue_id))
                )= item.name

        .vc-field-row
          .vc-field
            label.vc-label(for="startDate")
              | Ngày bắt đầu
              span.vc-req *
            input#startDate.vc-input(
              type="datetime-local"
              name="start_date"
              value=campaign.start_date_formatted
              required
            )
          .vc-field
            label.vc-label(for="endDate")
              | Ngày kết thúc
              span.vc-req *
            input#endDate.vc-input(
              type="datetime-local"
              name="end_date"
              value=campaign.end_date_formatted
              required
            )

        .vc-field
          label.vc-label(for="status") Trạng thái
          .vc-select-wrap
            select#status.vc-input.vc-select(name="status")
              option(value="active" selected=(campaign.status === "active")) Đang hoạt động
              option(value="inactive" selected=(campaign.status === "inactive")) Ngưng hoạt động
              option(value="expired" selected=(campaign.status === "expired")) Hết hạn

        .vc-modal-foot
          a.vc-btn-cancel(href=`${prefixAdmin}/finance`) Hủy
          button.vc-btn-submit(type="submit") Lưu thay đổi
    script(src="/js/script.js")
