extends ../../layouts/default.pug

block main
  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3.mb-4
    div
      h1.sz-title #{pageTitle}
      p.sz-subtitle Cấu hình sân con, bảng giá giờ vàng và lịch bảo trì cho cụm sân đang vận hành.
    .d-flex.gap-2.flex-wrap
      select.sz-select
        option SportPro Complex - Cầu Giấy
        option Arena Tây Hồ
      button.sz-btn.sz-btn-dark(type="button")
        i.bi.bi-plus-lg
        | Thêm cơ sở

  .sz-tabs.mb-4#facilityTabs
    button.sz-tab.active(type="button" data-tab="courts") Sân con (5)
    button.sz-tab(type="button" data-tab="pricing") Bảng giá & Giờ vàng (5)
    button.sz-tab(type="button" data-tab="locks") Khóa slot bảo trì (2)
    a.sz-tab(href=`${prefixAdmin}/facilities/venues`) Danh sách cơ sở (5)

  .sz-card.sz-panel
    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3
      div
        h2.sz-panel-title Danh sách sân thi đấu thuộc SportPro Complex
        p.sz-panel-sub Quản lý trạng thái hoạt động / bảo trì từng sân con
      button.sz-btn.sz-btn-green(type="button")
        i.bi.bi-plus-lg
        | Thêm sân con

    .row.g-3
      each court in courts
        .col-12.col-md-6.col-xl-4
          .sz-court-card(class=(court.status === "maintenance" ? "is-maint" : ""))
            .d-flex.justify-content-between.align-items-start.mb-2
              .d-flex.align-items-center.gap-2
                span.sz-court-icon
                  img(src= court.court_type_id.icon_url)
                strong.sz-court-name= court.name
              if court.status === "active"
                span.sz-badge.sz-badge-ok HOẠT ĐỘNG
              else
                span.sz-badge.sz-badge-danger ĐANG BẢO TRÌ
            ul.sz-court-meta
              li
                span Mặt sân
                strong= court.surface
              li
                span Loại hình
                strong  #{court.court_type_id.name}
            .sz-court-actions
              if court.status === "active"
                button.sz-btn.sz-btn-outline-danger.sz-btn-sm.btn-open-maintain(type="button")
                  i.bi.bi-exclamation-triangle
                  | Đưa vào bảo trì
              else
                button.sz-btn.sz-btn-green.sz-btn-sm(type="button")
                  i.bi.bi-check2-circle
                  | Mở lại sân

    script(src="/admin/js/courts.js")

