extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(5000)
  link(rel="stylesheet", href="/admin/css/price-rules.css")
  .pr-wrap
    a.pr-back(href=`${prefixOwner}/facilities/price-rules`) ← Quay lại Bảng giá & Giờ vàng
    .pr-card
      h1 Cấu hình Quy tắc Giá (Price Rule)
      p.pr-sub Hệ thống sẽ tự động nhân tỷ lệ giá khi khách chọn slot trùng khung giờ này.

      if error
        .pr-error= error

      form(method="POST" action=`${prefixOwner}/facilities/price-rules/edit/${priceRule._id}?_method=PATCH`)
        .pr-grid
          .pr-full
            label(for="name") Tên khung giá *
            input#name(type="text" name="name" required placeholder="VD: Giờ vàng tối" value=priceRule.name)

          div
            label(for="venue") Cơ sở *
            select#venue(name="venueId" required)
              option(value="") -- Chọn cơ sở --
              each v in venues
                option(value=v._id selected=(String(v._id) === String(venueId)))= v.name

          div
            label(for="court") Sân con (tương ứng) *
            select#court(name="court" required)
              each c in courts
                if String(c.venue_id) === String(venueId)
                  option(value=c._id selected=(String(priceRule.court) === String(c._id)))= c.name

          div
            label(for="dayType") Áp dụng ngày *
            select#dayType(name="dayType" required)
              option(value="weekday" selected=(priceRule.dayType === "weekday")) Thứ 2 - Thứ 6
              option(value="weekend" selected=(priceRule.dayType === "weekend")) Thứ 7 & Chủ Nhật
              option(value="all" selected=(priceRule.dayType === "all")) Tất cả các ngày

          div
            label(for="pricePerHour") Giá thuê mỗi giờ (VNĐ) *
            .pr-price
              input#pricePerHour(type="number" name="pricePerHour" min="0" step="1000" required value=priceRule.pricePerHour placeholder="190000")
              span đ

          div
            label(for="timeStart") Từ giờ *
            input#timeStart(type="time" name="timeStart" required value=priceRule.timeStart)

          div
            label(for="timeEnd") Đến giờ *
            input#timeEnd(type="time" name="timeEnd" required value=priceRule.timeEnd)

        .pr-actions
          a.pr-btn.pr-btn-ghost(href=`${prefixOwner}/facilities/price-rules`) Hủy
          button.pr-btn.pr-btn-main(type="submit") Lưu khung giá

  -
    const courtOptions = courts.map((c) => ({
      value: String(c._id),
      venueId: String(c.venue_id),
      name: c.name
    }));
  script.
    const venue = document.getElementById('venue');
    const court = document.getElementById('court');
    const allCourts = !{JSON.stringify(courtOptions).replace(/</g, '\\u003c')};

    const filter = (preferred) => {
      const venueId = venue.value;
      const current = preferred === undefined ? court.value : preferred;
      const matched = allCourts.filter((item) => item.venueId === venueId);
      court.replaceChildren();
      matched.forEach((item) => {
        const option = document.createElement('option');
        option.value = item.value;
        option.textContent = item.name;
        court.appendChild(option);
      });
      const stillThere = matched.some((item) => item.value === current);
      court.value = stillThere ? current : (matched[0] ? matched[0].value : '');
    };

    venue.addEventListener('change', () => filter(''));
    filter();
