extends ../../layouts/default
include ../../../mixins/alert.pug

block head
  link(rel="stylesheet" href="/admin/css/drinks.css")
  link(rel="stylesheet" href="/admin/css/drink-index.css")
  link(rel="stylesheet" href="/admin/css/sale.css")

block main
  +alert-success(2000)
  +alert-error(5000)
  - const list = typeof drinks !== "undefined" ? drinks : []
  - const LOW = 10
  - const computed = { total: list.length, active: list.filter((item) => item.status === "active").length, inactive: list.filter((item) => item.status === "inactive").length, lowStock: list.filter((item) => Number(item.stock) <= LOW).length, stockValue: list.reduce((sum, item) => sum + (Number(item.price) || 0) * (Number(item.stock) || 0), 0) }
  - const st = typeof stats !== "undefined" ? stats : computed
  - const fmt = (n) => Number(n || 0).toLocaleString("vi-VN") + "đ"

  //- ===== TIÊU ĐỀ + HÀNH ĐỘNG =====
  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3
    div
      h1.sz-page-title Dịch vụ giải khát
      p.sz-page-sub Quản lý đồ uống. Tồn kho tăng bằng phiếu nhập, không sửa số tồn trên form.
    .sl-actions
      a.sz-btn-outline(href=`${prefixAdmin}/drinks/create`)
        i.bi.bi-plus-lg
        |  Thêm sản phẩm
      a.sz-btn-primary(href=`${prefixOwner}/drinks/receipts/create`)
        i.bi.bi-box-arrow-in-down
        |  Tạo phiếu nhập
      a.sz-btn-outline(href=`${prefixOwner}/drinks/sales/create`)
        i.bi.bi-receipt
        |  Tạo phiếu bán

  - const tab = "products"
  include _tabs.pug

  //- ===== THẺ THỐNG KÊ =====
  .row.g-3.mt-1
    .col-6.col-xl-3
      .sz-stat
        .sz-stat-label TỔNG SẢN PHẨM
        .sz-stat-value #{st.total} <small>món</small>
        .sz-stat-note.green #{st.active} đang bán
    .col-6.col-xl-3
      .sz-stat
        .sz-stat-label NGỪNG BÁN
        .sz-stat-value #{st.inactive} <small>món</small>
        .sz-stat-note.gray Đang bị ẩn khỏi đặt sân
    .col-6.col-xl-3
      .sz-stat
        .sz-stat-label SẮP HẾT HÀNG
        .sz-stat-value #{st.lowStock} <small>món</small>
        .sz-stat-note.orange Tồn kho ≤ #{LOW} sản phẩm
    .col-6.col-xl-3
      .sz-stat
        .sz-stat-label GIÁ TRỊ TỒN KHO
        .sz-stat-value= fmt(st.stockValue)
        .sz-stat-note.green Theo giá bán hiện tại

  //- ===== TAB TRẠNG THÁI =====
  nav.sz-tabs.mt-4#drinkTabs(aria-label="Lọc trạng thái")
    button.sz-tab.active(type="button" data-status="") Tất cả (#{st.total})
    button.sz-tab(type="button" data-status="active") Đang bán (#{st.active})
    button.sz-tab(type="button" data-status="inactive") Ngừng bán (#{st.inactive})
    button.sz-tab(type="button" data-status="low") Sắp hết hàng (#{st.lowStock})

  //- ===== CARD DANH SÁCH =====
  .sz-card.sz-list-card.mt-3
    .d-flex.justify-content-between.align-items-end.flex-wrap.gap-3.mb-3
      div
        h2.sz-card-title Danh sách sản phẩm

      .sz-filter
        select.sz-input.sz-filter-select#drinkVenue
          option(value="") Tất cả cơ sở
          each v in (typeof venues !== "undefined" ? venues : [])
            option(value=String(v._id))= v.name
        .sz-search
          i.bi.bi-search
          input.sz-input#drinkKeyword(type="search" placeholder="Gõ tên món..." autocomplete="off")

    if list.length
      .sz-table-wrap
        table.sz-table
          thead
            tr
              th SẢN PHẨM
              th CƠ SỞ
              th NHÀ CUNG CẤP
              th GIÁ BÁN
              th GIÁ NHẬP
              th TỒN KHO
              th TRẠNG THÁI
              th.text-end THAO TÁC
          tbody
            each item in drinks
              - const venueKey = item.venueId && item.venueId._id ? item.venueId._id : item.venueId
              tr.is-drink-row(class=(item.status === "inactive" ? "is-off" : undefined) data-name=String(item.name || "").toLowerCase() data-venue=String(venueKey || "") data-status=item.status data-stock=item.stock || 0)
                td
                  .sz-product
                    img.sz-product-img(src=item.image alt=item.name loading="lazy" onerror="this.style.visibility='hidden'")
                    .sz-product-name= item.name
                td.sz-muted= item.venueId ? item.venueId.name : "—"
                td.sz-muted= item.supplier || "—"
                td
                  strong.sz-price= fmt(Math.floor(Number(item.price || 0) * 130 / 100))
                td.sz-muted= fmt(item.price)
                td
                  if item.stock === 0
                    span.sz-stock.out Hết hàng
                  else if item.stock <= LOW
                    span.sz-stock.low #{item.stock} · Sắp hết
                  else
                    span.sz-stock.ok= item.stock
                td
                  if item.status === "active"
                    span.sz-tag đang bán
                  else
                    span.sz-tag.off ngừng bán
                td
                  .sz-actions
                    a.sz-icon-btn(href=`${prefixOwner}/drinks/receipts/create?drinkId=${item._id}` title="Nhập kho")
                      i.bi.bi-box-arrow-in-down
                    a.sz-icon-btn(href=`${prefixOwner}/drinks/edit/${item._id}` title="Chỉnh sửa")
                      i.bi.bi-pencil-square
                    form(method="POST" action=`${prefixOwner}/drinks/change-status/${item._id}?_method=PATCH`)
                      input(type="hidden" name="status" value=(item.status === "active" ? "inactive" : "active"))
                      if item.status === "active"
                        button.sz-icon-btn.warn(type="submit" title="Ngừng bán")
                          i.bi.bi-pause-circle
                      else
                        button.sz-icon-btn.ok(type="submit" title="Mở bán lại")
                          i.bi.bi-play-circle
      p#drinkNoMatch.sz-card-sub(hidden) Không có món nào khớp.
    else
      .sz-empty
        i.bi.bi-cup-straw
        h3 Chưa có sản phẩm nào
        p Hãy thêm đồ uống đầu tiên để khách có thể đặt kèm khi đặt sân.
        a.sz-btn-primary(href=`${prefixAdmin}/drinks/create`)
          i.bi.bi-plus-lg
          |  Thêm sản phẩm

block script
  script.
    document.querySelectorAll("form[data-confirm]").forEach(function (form) {
      form.addEventListener("submit", function (e) {
        if (!confirm(form.dataset.confirm)) e.preventDefault();
      });
    });

    //- Lọc trên các dòng đã có trong trang. Gõ liên tục không gọi server.
    (function () {
      var keywordInput = document.getElementById("drinkKeyword");
      var venueSelect = document.getElementById("drinkVenue");
      var tabs = document.getElementById("drinkTabs");
      var empty = document.getElementById("drinkNoMatch");
      var rows = Array.prototype.slice.call(document.querySelectorAll(".is-drink-row"));
      if (!keywordInput || !venueSelect || !tabs) return;
      var status = "";

      function applyFilter() {
        var keyword = keywordInput.value.trim().toLowerCase();
        var venueId = venueSelect.value;
        var shown = 0;
        rows.forEach(function (row) {
          var name = row.getAttribute("data-name") || "";
          var venue = row.getAttribute("data-venue") || "";
          var rowStatus = row.getAttribute("data-status") || "";
          var stock = Number(row.getAttribute("data-stock") || 0);
          var ok = true;
          if (keyword && name.indexOf(keyword) === -1) ok = false;
          if (venueId && venue !== venueId) ok = false;
          if (status === "active" && rowStatus !== "active") ok = false;
          if (status === "inactive" && rowStatus !== "inactive") ok = false;
          if (status === "low" && stock > 10) ok = false;
          row.classList.toggle("is-hidden-by-filter", !ok);
          if (ok) shown += 1;
        });
        if (empty) empty.hidden = shown !== 0 || rows.length === 0;
      }

      keywordInput.addEventListener("input", applyFilter);
      venueSelect.addEventListener("change", applyFilter);
      tabs.addEventListener("click", function (event) {
        var button = event.target.closest("button[data-status]");
        if (!button) return;
        status = button.getAttribute("data-status") || "";
        Array.prototype.forEach.call(tabs.querySelectorAll(".sz-tab"), function (tab) {
          tab.classList.toggle("active", tab === button);
        });
        applyFilter();
      });
    })();
