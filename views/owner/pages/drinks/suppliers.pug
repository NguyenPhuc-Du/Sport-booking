extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block head
  link(rel="stylesheet" href="/admin/css/drinks.css")
  link(rel="stylesheet" href="/admin/css/drink-index.css")
  link(rel="stylesheet" href="/admin/css/sale.css")

block main
  +alert-success(3000)
  +alert-error(5000)
  - const list = typeof suppliers !== "undefined" ? suppliers : []
  - const tab = "suppliers"

  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3
    div
      h1.sz-page-title Nhà cung cấp
      p.sz-page-sub Danh mục nơi nhập hàng. Phiếu nhập kho bắt buộc chọn một nhà cung cấp đang dùng.
    .sl-actions
      a.sz-btn-outline(href=`${prefixOwner}/drinks`)
        i.bi.bi-cup-straw
        |  Sản phẩm
      a.sz-btn-primary(href=`${prefixOwner}/drinks/suppliers/create`)
        i.bi.bi-plus-lg
        |  Thêm nhà cung cấp

  include _tabs.pug

  .sz-card.sz-list-card.mt-3
    .d-flex.justify-content-between.align-items-end.flex-wrap.gap-3.mb-3
      div
        h2.sz-card-title Danh sách nhà cung cấp
      .sz-filter
        select.sz-input.sz-filter-select#supplierStatus
          option(value="") Tất cả trạng thái
          option(value="active") Đang dùng
          option(value="inactive") Ngừng dùng
        .sz-search
          i.bi.bi-search
          input.sz-input#supplierKeyword(type="search" placeholder="Tên, SĐT, địa chỉ..." autocomplete="off")

    if list.length
      .sz-table-wrap
        table.sz-table
          thead
            tr
              th TÊN
              th ĐIỆN THOẠI
              th ĐỊA CHỈ
              th TRẠNG THÁI
              th.text-end THAO TÁC
          tbody
            each item in list
              tr.is-supplier-row(data-name=String(item.name || "").toLowerCase() data-phone=String(item.phone || "").toLowerCase() data-address=String(item.address || "").toLowerCase() data-status=item.status)
                td
                  strong= item.name
                  if item.note
                    .sz-muted= item.note
                td.sz-muted= item.phone || "—"
                td.sz-muted= item.address || "—"
                td
                  if item.status === "active"
                    span.sz-tag đang dùng
                  else
                    span.sz-tag.off ngừng dùng
                td
                  .sz-actions
                    a.sz-icon-btn(href=`${prefixOwner}/drinks/suppliers/edit/${item._id}` title="Sửa")
                      i.bi.bi-pencil-square
                    form(method="POST" action=`${prefixOwner}/drinks/suppliers/change-status/${item._id}?_method=PATCH`)
                      input(type="hidden" name="status" value=(item.status === "active" ? "inactive" : "active"))
                      if item.status === "active"
                        button.sz-icon-btn.warn(type="submit" title="Ngừng dùng")
                          i.bi.bi-pause-circle
                      else
                        button.sz-icon-btn.ok(type="submit" title="Dùng lại")
                          i.bi.bi-play-circle
      p#supplierNoMatch.sz-card-sub(hidden) Không có nhà cung cấp nào khớp.
    else
      .sz-empty
        i.bi.bi-truck
        h3 Chưa có nhà cung cấp
        p Thêm nhà cung cấp trước khi lập phiếu nhập kho.
        a.sz-btn-primary(href=`${prefixOwner}/drinks/suppliers/create`)
          i.bi.bi-plus-lg
          |  Thêm nhà cung cấp

block script
  script.
    //- Lọc tên, số điện thoại, địa chỉ trên mảng đã tải. Không gửi request khi gõ.
    (function () {
      var keywordInput = document.getElementById("supplierKeyword");
      var statusSelect = document.getElementById("supplierStatus");
      var empty = document.getElementById("supplierNoMatch");
      var rows = Array.prototype.slice.call(document.querySelectorAll(".is-supplier-row"));
      if (!keywordInput || !statusSelect) return;

      function applyFilter() {
        var keyword = keywordInput.value.trim().toLowerCase();
        var status = statusSelect.value;
        var shown = 0;
        rows.forEach(function (row) {
          var blob = [
            row.getAttribute("data-name") || "",
            row.getAttribute("data-phone") || "",
            row.getAttribute("data-address") || ""
          ].join(" ");
          var okKeyword = !keyword || blob.indexOf(keyword) !== -1;
          var okStatus = !status || row.getAttribute("data-status") === status;
          var ok = okKeyword && okStatus;
          row.classList.toggle("is-hidden-by-filter", !ok);
          if (ok) shown += 1;
        });
        if (empty) empty.hidden = shown !== 0 || rows.length === 0;
      }

      keywordInput.addEventListener("input", applyFilter);
      statusSelect.addEventListener("change", applyFilter);
    })();
