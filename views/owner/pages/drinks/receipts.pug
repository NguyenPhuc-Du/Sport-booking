extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block head
  link(rel="stylesheet" href="/admin/css/drinks.css")
  link(rel="stylesheet" href="/admin/css/drink-index.css")
  link(rel="stylesheet" href="/admin/css/sale.css")

block main
  +alert-success(3000)
  +alert-error(5000)
  - const f = typeof filter !== "undefined" ? filter : {}
  - const list = typeof receipts !== "undefined" ? receipts : []
  - const pg = typeof pagination !== "undefined" ? pagination : { currentPage: 1, totalPage: 1 }
  - const fmt = (n) => Number(n || 0).toLocaleString("vi-VN") + "đ"
  - const tab = "receipts"
  - const qs = (o) => { const p = Object.assign({}, f, o); return Object.keys(p).filter(k => p[k]).map(k => k + "=" + encodeURIComponent(p[k])).join("&"); }
  - const when = (d) => d ? new Date(d).toLocaleString("vi-VN") : "—"

  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3
    div
      h1.sz-page-title Phiếu nhập kho
      p.sz-page-sub Hàng vào từ nhà cung cấp. Tồn kho chỉ tăng khi xác nhận phiếu này.
    .sl-actions
      a.sz-btn-outline(href=`${prefixOwner}/drinks/suppliers`)
        i.bi.bi-truck
        |  Nhà cung cấp
      a.sz-btn-primary(href=`${prefixOwner}/drinks/receipts/create`)
        i.bi.bi-plus-lg
        |  Tạo phiếu nhập

  include _tabs.pug

  .sz-card.sz-list-card.mt-3
    .mb-3
      h2.sz-card-title Danh sách phiếu
      p.sz-card-sub.mb-0 Mỗi phiếu cộng tồn ngay khi nhập. Hủy phiếu chỉ được khi còn đủ tồn.
    form.sz-bill-filter(method="GET" action=`${prefixOwner}/drinks/receipts`)
      label.sz-filter-field
        span Cơ sở
        select.sz-input.sz-filter-select(name="venueId" onchange="this.form.submit()")
          option(value="") Tất cả cơ sở
          each v in (typeof venues !== "undefined" ? venues : [])
            option(value=v._id selected=(String(f.venueId) === String(v._id)))= v.name
      label.sz-filter-field
        span Trạng thái
        select.sz-input.sz-filter-select(name="status" onchange="this.form.submit()")
          option(value="") Tất cả trạng thái
          option(value="received" selected=(f.status === "received")) Đã nhập
          option(value="cancelled" selected=(f.status === "cancelled")) Đã hủy
      label.sz-filter-field.sz-filter-span-2
        span Tìm kiếm
        .sz-search
          i.bi.bi-search
          input.sz-input(type="search" name="keyword" placeholder="Mã phiếu, nhà cung cấp..." value=f.keyword)
      label.sz-filter-field
        span Từ ngày
        input.sz-input(type="date" name="from" value=f.from || "")
      label.sz-filter-field
        span Đến ngày
        input.sz-input(type="date" name="to" value=f.to || "")
      label.sz-filter-field
        span Tiền từ
        input.sz-input(type="number" name="minAmount" min="0" step="1000" value=f.minAmount || "")
      label.sz-filter-field
        span Tiền đến
        input.sz-input(type="number" name="maxAmount" min="0" step="1000" value=f.maxAmount || "")
      .sz-filter-actions
        button.sz-btn-outline(type="submit") Lọc
        a.sz-btn-outline(href=`${prefixOwner}/drinks/receipts`) Xóa lọc
        a.sz-btn-outline(href=`${prefixOwner}/drinks/receipts/export?${qs({})}`) Xuất Excel
    .sz-sum
      span Tổng chi của bộ lọc
      strong= fmt(tongTien)
      span.sz-muted #{soPhieu} phiếu

    if list.length
      .sz-table-wrap
        table.sz-table.sl-split-table#sl-receipts-table(data-cancel-base=`${prefixOwner}/drinks/receipts/` data-pdf-base=`${prefixOwner}/drinks/receipts/`)
          thead
            tr
              th MÃ PHIẾU
              th THỜI GIAN
              th SỐ TIỀN
              th TRẠNG THÁI
              th.sl-col-fold NHÀ CUNG CẤP
              th.sl-col-fold CƠ SỞ
              th.sl-col-fold MÓN
              th.sl-col-action.text-end
              th.sl-detail-head CHI TIẾT
          tbody
            each bill, index in list
              - const at = bill.receivedAt || bill.createdAt
              tr.sl-row(data-receipt-id=String(bill._id) tabindex="0")
                td
                  strong.sl-code= bill.code
                td
                  if at
                    strong.sl-when= new Date(at).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" })
                    .sz-muted= new Date(at).toLocaleDateString("vi-VN")
                  else
                    | —
                td
                  strong.sz-price= fmt(bill.amount)
                td
                  if bill.status === "cancelled"
                    span.sz-tag.off Đã hủy
                  else
                    span.sz-tag Đã nhập
                td.sl-col-fold= bill.supplierName
                td.sl-col-fold.sz-muted= bill.venueName || "—"
                td.sl-col-fold= bill.items.length + " món"
                td.sl-col-action.text-end
                  span.sz-icon-btn(title="Xem phiếu")
                    i.bi.bi-box-arrow-in-down
                if index === 0
                  td.sl-detail-cell(rowspan=list.length)
                    .sl-bill-slot

      if pg.totalPage > 1
        nav.sz-pagination(aria-label="Phân trang")
          if pg.currentPage > 1
            a.sz-page(href=`?${qs({ page: pg.currentPage - 1 })}`)
              i.bi.bi-chevron-left
          - for (let i = 1; i <= pg.totalPage; i++)
            a.sz-page(href=`?${qs({ page: i })}` class=(i === pg.currentPage ? "active" : undefined))= i
          if pg.currentPage < pg.totalPage
            a.sz-page(href=`?${qs({ page: pg.currentPage + 1 })}`)
              i.bi.bi-chevron-right
    else
      .sz-empty
        i.bi.bi-box-arrow-in-down
        h3 Chưa có phiếu nhập
        p Khi hàng về, lập phiếu nhập để cộng tồn từ nhà cung cấp.
        a.sz-btn-primary(href=`${prefixOwner}/drinks/receipts/create`)
          i.bi.bi-plus-lg
          |  Tạo phiếu nhập

block script
  -
    const receiptsPayload = JSON.stringify((typeof receipts !== "undefined" ? receipts : []).map((bill) => ({
      id: String(bill._id),
      code: bill.code || "",
      supplierName: bill.supplierName || "",
      venueName: bill.venueName || "",
      status: bill.status || "",
      note: bill.note || "",
      amount: bill.amount || 0,
      receivedAt: bill.receivedAt || bill.createdAt || null,
      cancelledAt: bill.cancelledAt || null,
      items: (bill.items || []).map((line) => ({
        name: line.name || "",
        costPrice: line.costPrice || 0,
        qty: line.qty || 0,
        lineTotal: line.lineTotal || 0,
      })),
    }))).replace(/</g, "\\u003c")
  script#sl-receipts-data(type="application/json")!= receiptsPayload
  script.
    (function () {
      const table = document.getElementById("sl-receipts-table");
      const dataNode = document.getElementById("sl-receipts-data");
      if (!table || !dataNode) return;

      const receipts = JSON.parse(dataNode.textContent || "[]");
      const rows = Array.from(table.querySelectorAll(".sl-row"));
      const cancelBase = table.getAttribute("data-cancel-base") || "";
      const pdfBase = table.getAttribute("data-pdf-base") || "";
      let openId = null;

      const money = (n) => Number(n || 0).toLocaleString("vi-VN") + "đ";
      const when = (d) => (d ? new Date(d).toLocaleString("vi-VN") : "—");
      const statusLabel = (status) => {
        if (status === "received") return "Đã nhập";
        if (status === "cancelled") return "Đã hủy";
        return status || "—";
      };

      function el(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text != null) node.textContent = text;
        return node;
      }

      function meta(parent, label, value) {
        const row = el("div", "sl-meta-row");
        row.append(el("span", null, label), el("strong", null, value || "—"));
        parent.appendChild(row);
      }

      const BILL_ROWS = 8;

      function clearBills() {
        table.querySelectorAll(".sl-bill-slot").forEach((slot) => slot.replaceChildren());
      }

      function sizeBill() {
        const row = table.querySelector(".sl-row");
        const slot = table.querySelector(".sl-bill-slot");
        const wrap = table.closest(".sz-table-wrap");
        if (!row || !slot || !wrap) return;
        const rowH = row.getBoundingClientRect().height;
        const bodyH = table.tBodies[0].getBoundingClientRect().height;
        const billH = rowH * BILL_ROWS;
        slot.style.height = billH + "px";
        const extra = Math.max(0, billH - bodyH);
        wrap.style.paddingBottom = extra ? extra + "px" : "";
      }

      function resetBillSize() {
        const slot = table.querySelector(".sl-bill-slot");
        const wrap = table.closest(".sz-table-wrap");
        if (slot) slot.style.height = "";
        if (wrap) wrap.style.paddingBottom = "";
      }

      function closePanel() {
        openId = null;
        table.classList.remove("is-open");
        clearBills();
        resetBillSize();
      }

      function render(receipt) {
        const root = el("div", "sl-side-bill");
        const head = el("div", "sl-side-bill-head");
        const total = el("div", "sl-total");
        total.append(el("span", null, "Tổng nhập"), el("strong", null, money(receipt.amount)));
        const close = el("button", "sl-bill-close");
        close.type = "button";
        close.setAttribute("aria-label", "Đóng chi tiết");
        close.innerHTML = '<i class="bi bi-x-lg"></i>';
        close.addEventListener("click", function (event) {
          event.stopPropagation();
          closePanel();
        });
        head.append(total, close);
        root.appendChild(head);

        meta(root, "Mã phiếu", receipt.code);
        meta(root, "Thời gian", when(receipt.receivedAt));
        meta(root, "Nhà cung cấp", receipt.supplierName);
        meta(root, "Cơ sở", receipt.venueName);
        meta(root, "Trạng thái", statusLabel(receipt.status));
        if (receipt.status === "cancelled") meta(root, "Hủy lúc", when(receipt.cancelledAt));
        if (receipt.note) meta(root, "Ghi chú", receipt.note);

        const lines = el("div", "sl-side-lines");
        (receipt.items || []).forEach((line) => {
          const row = el("div", "sl-side-line");
          const left = el("div");
          left.append(
            el("div", "sl-side-line-name", line.name),
            el("div", "sl-side-line-meta", money(line.costPrice) + " × " + line.qty)
          );
          row.append(left, el("strong", "sz-price", money(line.lineTotal)));
          lines.appendChild(row);
        });
        root.appendChild(lines);

        if (receipt.status === "received") {
          const form = el("form", "sz-form-actions");
          form.method = "POST";
          form.action = cancelBase + receipt.id + "/cancel";
          form.addEventListener("submit", function (event) {
            const ok = window.confirm("Hủy phiếu sẽ trừ lại số lượng đã nhập. Chỉ hủy được khi từng món còn đủ tồn. Tiếp tục?");
            if (!ok) event.preventDefault();
          });
          const button = el("button", "sz-btn-outline", "Hủy phiếu nhập");
          button.type = "submit";
          form.appendChild(button);
          root.appendChild(form);
        }

        const pdf = el("a", "sz-btn-outline sl-pdf-btn", "Xuất PDF phiếu này");
        pdf.href = pdfBase + receipt.id + "/pdf";
        pdf.target = "_blank";
        pdf.rel = "noopener";
        root.appendChild(pdf);
        return root;
      }

      function openPanel(id) {
        const receipt = receipts.find((item) => item.id === id);
        const slot = table.querySelector(".sl-bill-slot");
        if (!receipt || !slot) return;
        openId = id;
        table.classList.add("is-open");
        clearBills();
        slot.appendChild(render(receipt));
        sizeBill();
      }

      rows.forEach((row) => {
        row.addEventListener("click", function () {
          if (openId === row.dataset.receiptId) closePanel();
          else openPanel(row.dataset.receiptId);
        });
        row.addEventListener("keydown", function (event) {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          if (openId === row.dataset.receiptId) closePanel();
          else openPanel(row.dataset.receiptId);
        });
      });

      const detailCell = table.querySelector(".sl-detail-cell");
      if (detailCell) {
        detailCell.addEventListener("click", function (event) {
          event.stopPropagation();
        });
      }
    })();
