extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block head
  link(rel="stylesheet" href="/admin/css/drinks.css")
  link(rel="stylesheet" href="/admin/css/drink-index.css")
  link(rel="stylesheet" href="/admin/css/sale.css")

block main
  +alert-success(3000)
  +alert-error(5000)
  - const venueList = typeof venues !== "undefined" ? venues : []
  - const products = typeof catalog !== "undefined" ? catalog : []

  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3.mb-3
    div
      h1.sz-page-title Tạo phiếu bán tại quầy
      p.sz-page-sub Khách mua nước trực tiếp — không gắn vào đơn đặt sân.
    a.sz-btn-outline(href=`${prefixOwner}/drinks/sales`)
      i.bi.bi-arrow-left
      |  Quay lại phiếu bán

  if !venueList.length
    .sz-card
      .sz-empty
        i.bi.bi-buildings
        h3 Chưa có cơ sở
        p Hãy tạo cơ sở trước khi bán đồ uống tại quầy.
        a.sz-btn-primary(href=`${prefixOwner}/facilities`) Quản lý cơ sở
  else
    form#saleForm(action=`${prefixOwner}/drinks/sales/create` method="POST" novalidate)
      input#saleItems(type="hidden" name="items" value="[]")
      .row.g-4.sl-pos
        .col-12.col-xl-7
          .sz-card
            .sz-card-head
              h2.sz-card-title Chọn sản phẩm
              p.sz-card-sub Lọc theo cơ sở rồi bấm vào món để thêm vào phiếu
            .mb-3
              label.sz-label(for="venueId") Cơ sở bán
                span.sz-req  *
              select#venueId.sz-input(name="venueId" required)
                option(value="") -- Chọn cơ sở --
                each v in venueList
                  option(value=v._id)= v.name
            #catalogEmpty.sz-empty(hidden)
              i.bi.bi-cup-straw
              h3 Chưa có món đang bán
              p Thêm sản phẩm đang bán và còn tồn kho cho cơ sở này.
              a.sz-btn-primary(href=`${prefixOwner}/drinks/create`) Thêm sản phẩm
            #catalogGrid.sl-catalog

        .col-12.col-xl-5
          .sz-card.sl-cart
            .sz-card-head
              h2.sz-card-title Phiếu hóa đơn
              p.sz-card-sub Thông tin khách và các món đã chọn
            .row.g-3.mb-3
              .col-12
                label.sz-label(for="guestName") Tên khách
                  span.sz-req  *
                input#guestName.sz-input(type="text" name="guestName" required maxlength="80" placeholder="Nguyễn Văn A")
              .col-12
                label.sz-label(for="guestPhone") Số điện thoại
                input#guestPhone.sz-input(type="tel" name="guestPhone" placeholder="0900 123 456" maxlength="14")
                .sz-hint Không bắt buộc. Nếu nhập phải đủ 10 số, bắt đầu bằng 0
              .col-12
                label.sz-label(for="paymentMethod") Hình thức thanh toán
                select#paymentMethod.sz-input(name="paymentMethod")
                  option(value="cash") Tiền mặt tại quầy
                  option(value="vnpay") Chuyển khoản QR
              .col-12
                label.sz-label(for="note") Ghi chú
                input#note.sz-input(type="text" name="note" maxlength="200" placeholder="Ví dụ: khách ngồi khán đài")

            h3.sz-card-title.mb-2 Giỏ hàng
            #cartList.sl-cart-list
              p#cartEmpty.sl-cart-empty Chưa có món nào. Chọn sản phẩm bên trái.
            .row.g-3.mt-2
              .col-12
                label.sz-label(for="voucherDrink") Voucher đồ uống
                select#voucherDrink.sz-input(name="voucherDrink")
                  option(value="") Không dùng
              .col-12
                label.sz-label(for="voucherOrder") Voucher hoá đơn
                select#voucherOrder.sz-input(name="voucherOrder")
                  option(value="") Không dùng
            p#saleVoucherHint.sz-hint Mỗi loại một mã. Tổng thu đã trừ voucher.
            .sl-total
              span Tạm tính
              strong#saleSubtotal 0đ
            .sl-discount#saleDiscountRow(hidden)
              span Giảm voucher
              strong#saleDiscount 0đ
            .sl-total
              span Tổng thu
              strong#saleTotal 0đ
            .sz-form-actions.mt-3.mb-0
              a.sz-btn-outline(href=`${prefixOwner}/drinks/sales`) Hủy
              button.sz-btn-primary(type="submit")
                i.bi.bi-receipt
                |  Xuất phiếu

block script
  script#saleCatalog(type="application/json")!= JSON.stringify(products)
  script#saleVouchers(type="application/json")!= JSON.stringify(vouchers || [])
  script.
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var fmt = function (n) { return Number(n || 0).toLocaleString("vi-VN") + "đ"; };
      var catalog = [];
      try { catalog = JSON.parse($("saleCatalog").textContent || "[]"); } catch (e) { catalog = []; }
      var cart = [];
      var venueEl = $("venueId");
      var grid = $("catalogGrid");
      var empty = $("catalogEmpty");
      var cartList = $("cartList");
      var cartEmpty = $("cartEmpty");
      var itemsInput = $("saleItems");
      var totalEl = $("saleTotal");
      var subtotalEl = $("saleSubtotal");
      var discountRow = $("saleDiscountRow");
      var discountEl = $("saleDiscount");
      var voucherHint = $("saleVoucherHint");
      var vouchers = [];
      try { vouchers = JSON.parse($("saleVouchers").textContent || "[]"); } catch (e) { vouchers = []; }
      var voucherError = "";

      function productsOfVenue() {
        var venueId = venueEl.value;
        return catalog.filter(function (item) {
          return item.venueId === venueId && item.status === "active";
        });
      }

      function renderCatalog() {
        var list = productsOfVenue();
        grid.innerHTML = "";
        if (!venueEl.value) {
          empty.hidden = true;
          return;
        }
        if (!list.length) {
          empty.hidden = false;
          return;
        }
        empty.hidden = true;
        list.forEach(function (item) {
          var soldOut = item.stock < 1;
          var btn = document.createElement("button");
          btn.type = "button";
          btn.className = "sl-product";
          btn.disabled = soldOut;
          var img = document.createElement("img");
          img.className = "sl-product-img";
          img.alt = "";
          img.src = item.image || "";
          img.addEventListener("error", function () { img.style.visibility = "hidden"; });
          var body = document.createElement("div");
          body.className = "sl-product-body";
          var name = document.createElement("div");
          name.className = "sl-product-name";
          name.textContent = item.name;
          var price = document.createElement("div");
          price.className = "sl-product-price";
          price.textContent = fmt(item.price);
          var stock = document.createElement("div");
          stock.className = "sl-product-stock";
          stock.textContent = soldOut ? "Hết hàng" : ("Còn " + item.stock);
          body.appendChild(name);
          body.appendChild(price);
          body.appendChild(stock);
          btn.appendChild(img);
          btn.appendChild(body);
          btn.addEventListener("click", function () { addItem(item.id); });
          grid.appendChild(btn);
        });
      }

      function findProduct(id) {
        for (var i = 0; i < catalog.length; i += 1) {
          if (catalog[i].id === id) return catalog[i];
        }
        return null;
      }

      function addItem(id) {
        var product = findProduct(id);
        if (!product || product.stock < 1) return;
        var line = cart.filter(function (row) { return row.id === id; })[0];
        if (line) {
          if (line.qty >= product.stock) return;
          line.qty += 1;
        } else {
          cart.push({ id: id, qty: 1 });
        }
        renderCart();
      }

      function toMin(value) {
        var parts = String(value || "00:00").slice(0, 5).split(":");
        return Number(parts[0]) * 60 + Number(parts[1] || 0);
      }

      function rawDiscount(voucher, base) {
        var discount = voucher.discountType === "fixed"
          ? Number(voucher.discountValue) || 0
          : Math.round((base * (Number(voucher.discountValue) || 0)) / 100);
        if (voucher.discountType !== "fixed" && voucher.maxDiscount != null) {
          discount = Math.min(discount, Number(voucher.maxDiscount) || 0);
        }
        return Math.min(Math.max(discount, 0), base);
      }

      function saleDayKind() {
        var parts = new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Ho_Chi_Minh",
          weekday: "short",
        }).formatToParts(new Date());
        var found = parts.find(function (part) { return part.type === "weekday"; });
        var name = found ? found.value : "";
        return name === "Sat" || name === "Sun" ? "weekend" : "weekday";
      }

      function saleNowMinutes() {
        var parts = new Intl.DateTimeFormat("en-GB", {
          timeZone: "Asia/Ho_Chi_Minh",
          hour: "2-digit",
          minute: "2-digit",
          hourCycle: "h23",
        }).formatToParts(new Date());
        var get = function (type) {
          var found = parts.find(function (part) { return part.type === type; });
          return found ? found.value : "00";
        };
        return toMin(get("hour") + ":" + get("minute"));
      }

      function voucherFitsSale(voucher, scope) {
        if (!voucher || voucher.venueId !== venueEl.value || voucher.applyScope !== scope) return false;
        if (voucher.dayType && voucher.dayType !== "all" && voucher.dayType !== saleDayKind()) return false;
        if (voucher.timeStart && voucher.timeEnd) {
          var minute = saleNowMinutes();
          if (minute < toMin(voucher.timeStart) || minute >= toMin(voucher.timeEnd)) return false;
        }
        return true;
      }

      function fillSaleVouchers() {
        ["voucherDrink", "voucherOrder"].forEach(function (id) {
          var select = $(id);
          if (!select) return;
          var scope = id === "voucherDrink" ? "drink" : "order";
          var current = select.value;
          select.replaceChildren();
          var none = document.createElement("option");
          none.value = "";
          none.textContent = "Không dùng";
          select.appendChild(none);
          vouchers.forEach(function (voucher) {
            if (!voucherFitsSale(voucher, scope)) return;
            var option = document.createElement("option");
            option.value = voucher.code;
            option.textContent = voucher.code + " · " + voucher.name;
            select.appendChild(option);
          });
          var still = Array.prototype.some.call(select.options, function (option) {
            return option.value === current;
          });
          select.value = still ? current : "";
        });
      }

      function chosenVoucher(id) {
        var select = $(id);
        if (!select || !select.value) return null;
        for (var i = 0; i < vouchers.length; i += 1) {
          if (vouchers[i].code === select.value) return vouchers[i];
        }
        return null;
      }

      function cartLines() {
        return cart.map(function (row) {
          var product = findProduct(row.id);
          return product ? { id: product.id, price: product.price, qty: row.qty } : null;
        }).filter(Boolean);
      }

      function quoteSale(subtotal) {
        var drinkV = chosenVoucher("voucherDrink");
        var orderV = chosenVoucher("voucherOrder");
        var lines = cartLines();
        var drinkBase = subtotal;
        if (drinkV) {
          var allowed = drinkV.productIds || [];
          drinkBase = lines.reduce(function (sum, line) {
            if (allowed.length && allowed.indexOf(String(line.id)) === -1) return sum;
            return sum + line.price * line.qty;
          }, 0);
          if (drinkBase <= 0) return { ok: false, message: "Giỏ không có đồ uống đủ điều kiện áp mã " + drinkV.code };
          if (drinkBase < (Number(drinkV.minOrderAmount) || 0)) {
            return { ok: false, message: "Đơn chưa đủ điều kiện áp dụng mã " + drinkV.code };
          }
        }
        if (orderV && subtotal < (Number(orderV.minOrderAmount) || 0)) {
          return { ok: false, message: "Đơn chưa đủ điều kiện áp dụng mã " + orderV.code };
        }
        var drinkOff = drinkV ? rawDiscount(drinkV, drinkBase) : 0;
        var remain = Math.max(subtotal - drinkOff, 0);
        var orderOff = orderV ? rawDiscount(orderV, remain) : 0;
        return { ok: true, discount: drinkOff + orderOff, payable: Math.max(subtotal - drinkOff - orderOff, 0) };
      }

      function syncItems() {
        var amount = 0;
        cart.forEach(function (row) {
          var product = findProduct(row.id);
          if (product) amount += product.price * row.qty;
        });
        var quote = quoteSale(amount);
        voucherError = quote.ok ? "" : quote.message;
        var payable = quote.ok ? quote.payable : amount;
        var discount = quote.ok ? quote.discount : 0;
        if (subtotalEl) subtotalEl.textContent = fmt(amount);
        if (discountRow) discountRow.hidden = !discount;
        if (discountEl) discountEl.textContent = fmt(discount);
        totalEl.textContent = fmt(payable);
        if (voucherHint) {
          voucherHint.textContent = voucherError || (discount
            ? "Giảm " + fmt(discount) + ". Khách thanh toán " + fmt(payable) + "."
            : "Mỗi loại một mã. Tổng thu đã trừ voucher.");
        }
        itemsInput.value = JSON.stringify(cart.map(function (row) {
          return { drinkId: row.id, qty: row.qty };
        }));
      }

      function changeQty(id, delta) {
        var product = findProduct(id);
        cart = cart.map(function (row) {
          if (row.id !== id) return row;
          var next = row.qty + delta;
          if (product) next = Math.min(next, product.stock);
          return { id: row.id, qty: next };
        }).filter(function (row) { return row.qty > 0; });
        renderCart();
      }

      function showQtyError(input, errorEl, message) {
        input.classList.add("is-invalid");
        errorEl.hidden = false;
        errorEl.textContent = message;
      }

      function clearQtyError(input, errorEl) {
        input.classList.remove("is-invalid");
        errorEl.hidden = true;
        errorEl.textContent = "";
      }

      function applyTypedQty(row, product, input, errorEl, meta, total, plus) {
        var raw = input.value.trim();
        if (raw === "") {
          showQtyError(input, errorEl, "Nhập số lượng");
          return;
        }
        if (!/^\d+$/.test(raw)) {
          showQtyError(input, errorEl, "Số lượng phải là số nguyên");
          return;
        }
        var qty = Number(raw);
        if (qty < 1) {
          showQtyError(input, errorEl, "Số lượng tối thiểu là 1");
          return;
        }
        if (qty > product.stock) {
          showQtyError(input, errorEl, "Không vượt tồn kho (còn " + product.stock + ")");
          return;
        }
        clearQtyError(input, errorEl);
        row.qty = qty;
        meta.textContent = fmt(product.price) + " × " + qty;
        total.textContent = fmt(product.price * qty);
        plus.disabled = qty >= product.stock;
        syncItems();
      }

      function renderCart() {
        cartList.querySelectorAll(".sl-line").forEach(function (el) { el.remove(); });
        cart.forEach(function (row) {
          var product = findProduct(row.id);
          if (!product) return;
          var line = document.createElement("div");
          line.className = "sl-line";

          var info = document.createElement("div");
          var name = document.createElement("div");
          name.className = "sl-line-name";
          name.textContent = product.name;
          var meta = document.createElement("div");
          meta.className = "sl-line-meta";
          meta.textContent = fmt(product.price) + " × " + row.qty;
          info.appendChild(name);
          info.appendChild(meta);

          var side = document.createElement("div");
          var lineTotal = document.createElement("div");
          lineTotal.className = "sl-line-total";
          lineTotal.textContent = fmt(product.price * row.qty);

          var qty = document.createElement("div");
          qty.className = "sl-qty";
          var minus = document.createElement("button");
          minus.type = "button";
          minus.textContent = "−";
          minus.addEventListener("click", function () { changeQty(row.id, -1); });

          var input = document.createElement("input");
          input.type = "number";
          input.className = "sl-qty-input";
          input.min = "1";
          input.max = String(product.stock);
          input.step = "1";
          input.inputMode = "numeric";
          input.value = String(row.qty);
          input.setAttribute("aria-label", "Số lượng " + product.name);

          var plus = document.createElement("button");
          plus.type = "button";
          plus.textContent = "+";
          plus.disabled = row.qty >= product.stock;
          plus.addEventListener("click", function () { changeQty(row.id, 1); });

          var errorEl = document.createElement("p");
          errorEl.className = "sl-qty-error";
          errorEl.hidden = true;

          input.addEventListener("input", function () {
            applyTypedQty(row, product, input, errorEl, meta, lineTotal, plus);
          });
          input.addEventListener("blur", function () {
            var raw = input.value.trim();
            if (raw === "" || !/^\d+$/.test(raw) || Number(raw) < 1) {
              input.value = String(row.qty);
              clearQtyError(input, errorEl);
              plus.disabled = row.qty >= product.stock;
              return;
            }
            if (Number(raw) > product.stock) {
              showQtyError(input, errorEl, "Không vượt tồn kho (còn " + product.stock + ")");
            }
          });
          input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
              e.preventDefault();
              input.blur();
            }
          });
          input.addEventListener("wheel", function (e) { e.preventDefault(); });

          qty.appendChild(minus);
          qty.appendChild(input);
          qty.appendChild(plus);
          side.appendChild(lineTotal);
          side.appendChild(qty);
          line.appendChild(info);
          line.appendChild(side);
          line.appendChild(errorEl);
          cartList.appendChild(line);
        });
        cartEmpty.hidden = cart.length > 0;
        syncItems();
      }

      venueEl.addEventListener("change", function () {
        cart = [];
        fillSaleVouchers();
        renderCatalog();
        renderCart();
      });
      ["voucherDrink", "voucherOrder"].forEach(function (id) {
        var select = $(id);
        if (select) select.addEventListener("change", syncItems);
      });

      $("saleForm").addEventListener("submit", function (e) {
        var bad = false;
        if (!venueEl.value) { venueEl.classList.add("is-invalid"); bad = true; } else { venueEl.classList.remove("is-invalid"); }
        var nameEl = $("guestName");
        if (!nameEl.value.trim()) { nameEl.classList.add("is-invalid"); bad = true; } else { nameEl.classList.remove("is-invalid"); }
        var phone = $("guestPhone").value.replace(/\D/g, "");
        if (phone && !/^0\d{9}$/.test(phone)) { $("guestPhone").classList.add("is-invalid"); bad = true; }
        else { $("guestPhone").classList.remove("is-invalid"); }
        if (!cart.length) { bad = true; alert("Chưa chọn sản phẩm nào"); }
        if (voucherError) { bad = true; alert(voucherError); }
        var overStock = cart.some(function (row) {
          var product = findProduct(row.id);
          return !product || !Number.isInteger(row.qty) || row.qty < 1 || row.qty > product.stock;
        });
        if (cartList.querySelector(".sl-qty-input.is-invalid") || overStock) {
          bad = true;
          alert("Số lượng phải là số nguyên từ 1 đến tồn kho hiện tại");
        }
        if (bad) e.preventDefault();
      });

      fillSaleVouchers();
      renderCatalog();
      renderCart();
    })();
