extends ../../layouts/default.pug

block main
  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3.mb-4
    div
      h1.sz-title Tổng quan Hoạt động & Doanh thu
      p.sz-subtitle
        | Cơ sở:&nbsp;
        strong= venueName
        |  ·
        span.sz-live
          span.sz-live-dot
          | Dữ liệu cập nhật realtime
    .sz-range#rangeTabs
      a(href=`${prefixOwner}/dashboard?range=7d` class=(range === "7d" ? "active" : undefined)) 7 ngày qua
      a(href=`${prefixOwner}/dashboard?range=month` class=(range === "month" ? "active" : undefined)) Tháng này
      a(href=`${prefixOwner}/dashboard?range=quarter` class=(range === "quarter" ? "active" : undefined))= `Quý này`

  .row.g-3.mb-3
    each s in stats
      .col-12.col-sm-6.col-xl-3
        .sz-card.sz-stat
          .d-flex.justify-content-between.align-items-start
            span.sz-stat-label= s.label
          .sz-stat-value= s.value
          .sz-stat-note(class=s.noteClass)= s.note

  .row.g-3.mb-3
    .col-12.col-xl-7
      .sz-card.sz-panel.h-100
        .d-flex.justify-content-between.align-items-start.flex-wrap.gap-2
          div
            h2.sz-panel-title= `Biểu đồ doanh thu ${rangeLabel}`
            p.sz-panel-sub Đơn vị: triệu đồng · 7 ngày gần nhất trong kỳ
          .sz-legend
            span.sz-legend-dot
            |  Doanh thu ngày
        #barChart.sz-chart(data-chart=JSON.stringify(chartData) aria-label="Biểu đồ doanh thu")

    .col-12.col-xl-5
      .sz-card.sz-panel.h-100
        h2.sz-panel-title Phân bổ khung giờ cao điểm
        p.sz-panel-sub Tỷ lệ lấp đầy theo khung giờ
        #peakList.sz-peak-list(data-peak=JSON.stringify(peakData))

  .row.g-3
    .col-12.col-xl-6
      .sz-card.sz-panel
        .d-flex.justify-content-between.align-items-center.mb-3
          div
            h2.sz-panel-title Sân có doanh thu cao nhất
            p.sz-panel-sub= `Top sân theo doanh thu ${rangeLabel}`
          a.sz-link(href=`${prefixOwner}/facilities`) Quản lý sân →
        if topCourts.length
          ul.sz-rank-list
            each c in topCourts
              li.sz-rank-item
                span.sz-rank-num= c.rank
                .sz-rank-body
                  .sz-rank-name= c.name
                  .sz-rank-meta= `${c.sport} · ${c.bookings} lượt đặt`
                  .sz-mini-track
                    .sz-mini-fill(style=`width:${c.fill}%`)
                  .sz-rank-fill Lấp đầy #{c.fill}%
                .sz-rank-money= c.revenue
        else
          p.sz-panel-sub.mb-0 Chưa có đơn đặt sân trong kỳ này.

    .col-12.col-xl-6
      .sz-card.sz-panel
        .d-flex.justify-content-between.align-items-center.mb-3
          div
            h2.sz-panel-title Đơn đặt sân mới nhất
            p.sz-panel-sub= latestBookings.length ? `${latestBookings.length} giao dịch gần đây` : "Chưa có giao dịch"
          a.sz-link(href=`${prefixOwner}/bookings`) Xem tất cả →
        if latestBookings.length
          ul.sz-booking-list
            each b in latestBookings
              li.sz-booking-item
                .sz-booking-top
                  span.sz-booking-code= `${b.code} · ${b.pay}`
                  span.sz-status(class=`is-${b.status}`)= b.statusLabel
                .sz-booking-main
                  strong= b.customer
                  span · #{b.court}
                .sz-booking-bottom
                  span= b.time
                  strong= b.amount
        else
          p.sz-panel-sub.mb-0 Chưa có đơn đặt sân để hiển thị.
