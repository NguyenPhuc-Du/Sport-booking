extends ../../layouts/default.pug

block head
  link(rel="stylesheet" href="/admin/css/drinks.css")
  link(rel="stylesheet" href="/admin/css/drink-index.css")
  style.
    .rp-hero { display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:20px; }
    .rp-actions { display:flex; flex-wrap:wrap; gap:10px; }
    .rp-btn {
      display:inline-flex; align-items:center; gap:8px; border-radius:12px;
      padding:11px 16px; font-weight:700; font-size:14px; text-decoration:none;
      border:1px solid transparent; line-height:1.2; cursor:pointer;
    }
    .rp-btn-primary { background:#0f172a; color:#fff; box-shadow:0 8px 18px rgba(15,23,42,.18); }
    .rp-btn-primary:hover { background:#1e293b; color:#fff; }
    .rp-btn-outline { background:#fff; color:#0f172a; border-color:#cbd5e1; }
    .rp-btn-outline:hover { border-color:#0f766e; color:#0f766e; background:#f0fdfa; }
    .rp-btn-soft { background:#ecfdf5; color:#0f766e; border-color:#99f6e4; }
    .rp-btn-soft:hover { background:#ccfbf1; color:#115e59; }
    .rp-panel {
      border:1px solid #e2e8f0; border-radius:18px; background:#fff; padding:18px;
      margin-bottom:16px; box-shadow:0 10px 30px rgba(15,23,42,.04);
    }
    .rp-panel-title { font-size:13px; font-weight:800; color:#0f172a; margin-bottom:14px; }
    .rp-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
    .rp-grid-3 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
    .rp-field label { display:block; font-size:12px; font-weight:700; color:#64748b; margin-bottom:6px; }
    .rp-field .sz-input, .rp-field select.sz-input { width:100%; max-width:none; }
    .rp-stat {
      border:1px solid #e2e8f0; border-radius:16px; padding:16px 18px;
      background:linear-gradient(180deg,#fff 0%,#f8fafc 100%); height:100%;
    }
    .rp-stat-label { display:block; color:#64748b; font-size:12px; font-weight:700; text-transform:uppercase; margin-bottom:8px; }
    .rp-stat-value { font-size:1.35rem; font-weight:800; color:#0f172a; }
    .rp-stat.is-profit .rp-stat-value { color:#0f766e; }
    .rp-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
    .rp-tab {
      display:inline-flex; align-items:center; padding:10px 14px; border-radius:999px;
      border:1px solid #e2e8f0; background:#fff; color:#475569; font-weight:700; font-size:13px; text-decoration:none;
    }
    .rp-tab:hover { border-color:#99f6e4; color:#0f766e; }
    .rp-tab.active { background:#0f766e; border-color:#0f766e; color:#fff; box-shadow:0 8px 16px rgba(15,118,110,.22); }
    .rp-section-head { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
    .rp-empty {
      border:1px dashed #cbd5e1; border-radius:16px; padding:28px; text-align:center; color:#64748b; background:#f8fafc;
    }
    .rp-note { font-size:12px; color:#64748b; }
    .rp-table td, .rp-table th { white-space:nowrap; }
    .rp-period-box { display:none; }
    .rp-period-box.is-on { display:block; }
    @media (max-width:992px) {
      .rp-grid, .rp-grid-3 { grid-template-columns:1fr 1fr; }
    }
    @media (max-width:640px) {
      .rp-grid, .rp-grid-3 { grid-template-columns:1fr; }
    }

block main
  - const f = typeof filter !== "undefined" ? filter : {}
  - const s = typeof summary !== "undefined" ? summary : { invoiceCount: 0, revenueText: "0đ", expenseText: "0đ", profitText: "0đ" }
  - const qm = typeof quarterMatrix !== "undefined" ? quarterMatrix : { year: f.year, thu: {}, chi: {}, profit: {} }
  - const cust = typeof customerStats !== "undefined" ? customerStats : { rows: [], all: { name: "TẤT CẢ", total: 0 }, totalCount: 0 }
  - const prod = typeof productStats !== "undefined" ? productStats : { rows: [], all: { name: "Tất cả", total: 0 }, totalCount: 0, showQuarters: false }
  - const money = (n) => `${Number(n || 0).toLocaleString("vi-VN")}đ`
  - const qs = (o = {}) => { const p = Object.assign({}, f, o, { run: 1 }); return Object.keys(p).filter((k) => p[k] !== undefined && p[k] !== "" && p[k] !== false).map((k) => k + "=" + encodeURIComponent(p[k] === true ? "1" : p[k])).join("&"); }
  - const tab = f.tab || "overview"
  - const showAll = !!f.expand
  - const custRows = showAll ? cust.rows : cust.rows.slice(0, 10)
  - const prodRows = showAll ? prod.rows : prod.rows.slice(0, 10)
  - const showResults = Boolean(typeof hasResults !== "undefined" && hasResults)

  .rp-hero
    div
      h1.sz-title Báo cáo tài chính
      p.sz-subtitle Chọn bộ lọc rồi bấm Lọc để xem tổng hợp, khách hàng và sản phẩm
    if showResults
      .rp-actions
        a.rp-btn.rp-btn-primary(href=`${prefixOwner}/dashboard/reports/export.xlsx?${qs()}`)
          i.bi.bi-file-earmark-excel
          span Xuất Excel
        a.rp-btn.rp-btn-outline(href=`${prefixOwner}/dashboard/reports/export.pdf?${qs()}`)
          i.bi.bi-file-earmark-pdf
          span Xuất PDF

  .rp-panel
    .rp-panel-title Bộ lọc báo cáo
    form#report-filter(method="GET" action=`${prefixOwner}/dashboard/reports`)
      input(type="hidden" name="run" value="1")
      input(type="hidden" name="tab" value=tab)
      .rp-grid.mb-3
        .rp-field
          label Cơ sở
          select.sz-input(name="venueId")
            option(value="") Tất cả cơ sở
            each v in (venues || [])
              option(value=v._id selected=(String(f.venueId || "") === String(v._id)))= v.name
        .rp-field
          label Kiểu thời gian
          select#periodType.sz-input(name="periodType")
            option(value="date" selected=(f.periodType === "date" || !f.periodType)) Theo ngày
            option(value="quarter" selected=(f.periodType === "quarter")) Theo quý
            option(value="year" selected=(f.periodType === "year")) Theo năm
        .rp-field
          label Tổng tiền từ
          input.sz-input(type="number" name="amountMin" placeholder="0" min="0" value=(f.amountMin === "" || f.amountMin === undefined ? "" : f.amountMin))
        .rp-field
          label Tổng tiền đến
          input.sz-input(type="number" name="amountMax" placeholder="Không giới hạn" min="0" value=(f.amountMax === "" || f.amountMax === undefined ? "" : f.amountMax))

      #period-date.rp-period-box(class=(f.periodType === "date" || !f.periodType ? "is-on" : undefined))
        .rp-grid-3.mb-3
          .rp-field
            label Từ ngày
            input.sz-input(type="date" name="dateFrom" value=f.dateFrom)
          .rp-field
            label Đến ngày
            input.sz-input(type="date" name="dateTo" value=f.dateTo)

      #period-quarter.rp-period-box(class=(f.periodType === "quarter" ? "is-on" : undefined))
        .rp-grid-3.mb-3
          .rp-field
            label Năm
            input.sz-input(type="number" name="year" min="2020" max="2100" value=f.year)
          .rp-field
            label Quý
            select.sz-input(name="quarter")
              option(value="1" selected=(Number(f.quarter) === 1)) Quý 1
              option(value="2" selected=(Number(f.quarter) === 2)) Quý 2
              option(value="3" selected=(Number(f.quarter) === 3)) Quý 3
              option(value="4" selected=(Number(f.quarter) === 4)) Quý 4

      #period-year.rp-period-box(class=(f.periodType === "year" ? "is-on" : undefined))
        .rp-grid-3.mb-3
          .rp-field
            label Năm
            input.sz-input#yearOnly(type="number" min="2020" max="2100" value=f.year disabled=(f.periodType !== "year"))

      .d-flex.flex-wrap.gap-2
        button.rp-btn.rp-btn-primary(type="submit")
          i.bi.bi-funnel
          span Lọc
        a.rp-btn.rp-btn-soft(href=`${prefixOwner}/dashboard/reports`) Xóa lọc

  if !showResults
    .rp-empty
      i.bi.bi-bar-chart-line(style="font-size:28px;display:block;margin-bottom:8px")
      strong Chưa có kết quả
      p.mb-0.mt-1 Chọn cơ sở, khoảng thời gian và tổng tiền rồi bấm <strong>Lọc</strong>.

  else
    .row.g-3.mb-3
      .col-12.col-md-3
        .rp-stat
          span.rp-stat-label Kỳ báo cáo
          .rp-stat-value(style="font-size:1rem")= periodLabel
      .col-12.col-md-3
        .rp-stat
          span.rp-stat-label Số hóa đơn
          .rp-stat-value= s.invoiceCount
      .col-12.col-md-3
        .rp-stat
          span.rp-stat-label Tổng thu
          .rp-stat-value= s.revenueText
      .col-12.col-md-3
        .rp-stat.is-profit
          span.rp-stat-label Lợi nhuận
          .rp-stat-value= s.profitText

    .rp-tabs
      a.rp-tab(href=`?${qs({ tab: "overview", expand: showAll ? 1 : "" })}` class=(tab === "overview" ? "active" : undefined)) Tổng hợp quý
      a.rp-tab(href=`?${qs({ tab: "customers", expand: showAll ? 1 : "" })}` class=(tab === "customers" ? "active" : undefined)) Theo khách hàng
      a.rp-tab(href=`?${qs({ tab: "products", expand: showAll ? 1 : "" })}` class=(tab === "products" ? "active" : undefined)) Theo sản phẩm

    if tab === "overview"
      .rp-panel
        .rp-section-head
          h2.sz-title(style="font-size:1.15rem;margin:0") Tổng hợp thu / chi / lợi nhuận · năm #{qm.year}
        .sz-table-wrap
          table.sz-table.rp-table
            thead
              tr
                th #{qm.year}
                th Q1
                th Q2
                th Q3
                th Q4
                th Tổng
            tbody
              tr
                td= qm.thu.label
                td= money(qm.thu.q1)
                td= money(qm.thu.q2)
                td= money(qm.thu.q3)
                td= money(qm.thu.q4)
                td
                  strong= money(qm.thu.total)
              tr
                td= qm.chi.label
                td= money(qm.chi.q1)
                td= money(qm.chi.q2)
                td= money(qm.chi.q3)
                td= money(qm.chi.q4)
                td
                  strong= money(qm.chi.total)
              tr
                td
                  strong= qm.profit.label
                td
                  strong= money(qm.profit.q1)
                td
                  strong= money(qm.profit.q2)
                td
                  strong= money(qm.profit.q3)
                td
                  strong= money(qm.profit.q4)
                td
                  strong= money(qm.profit.total)

    else if tab === "customers"
      .rp-panel
        .rp-section-head
          div
            h2.sz-title(style="font-size:1.15rem;margin:0") Theo khách hàng
            p.rp-note.mb-0 #{cust.totalCount} khách · đang xem #{custRows.length} dòng
          if cust.totalCount > 10
            if showAll
              a.rp-btn.rp-btn-soft(href=`?${qs({ tab: "customers", expand: "" })}`) Thu gọn
            else
              a.rp-btn.rp-btn-outline(href=`?${qs({ tab: "customers", expand: 1 })}`) Xem tất cả
        .sz-table-wrap
          table.sz-table.rp-table
            thead
              tr
                th Khách hàng
                th SĐT
                th Tổng
            tbody
              each row in custRows
                tr
                  td= row.name
                  td= row.phone || "—"
                  td
                    strong= money(row.total)
              tr
                td(colspan="2")
                  strong= cust.all.name
                td
                  strong= money(cust.all.total)

    else if tab === "products"
      .rp-panel
        .rp-section-head
          div
            h2.sz-title(style="font-size:1.15rem;margin:0") Theo sản phẩm
            p.rp-note.mb-0 #{prod.totalCount} sản phẩm · đang xem #{prodRows.length} dòng
          if prod.totalCount > 10
            if showAll
              a.rp-btn.rp-btn-soft(href=`?${qs({ tab: "products", expand: "" })}`) Thu gọn
            else
              a.rp-btn.rp-btn-outline(href=`?${qs({ tab: "products", expand: 1 })}`) Xem tất cả
        .sz-table-wrap
          table.sz-table.rp-table
            thead
              if prod.showQuarters
                tr
                  th Sản phẩm
                  th Q1
                  th Q2
                  th Q3
                  th Q4
                  th TỔNG
              else
                tr
                  th Sản phẩm
                  th TỔNG
            tbody
              each row in prodRows
                if prod.showQuarters
                  tr
                    td= row.name
                    td= money(row.q1)
                    td= money(row.q2)
                    td= money(row.q3)
                    td= money(row.q4)
                    td
                      strong= money(row.total)
                else
                  tr
                    td= row.name
                    td
                      strong= money(row.total)
              if prod.showQuarters
                tr
                  td
                    strong= prod.all.name
                  td
                    strong= money(prod.all.q1)
                  td
                    strong= money(prod.all.q2)
                  td
                    strong= money(prod.all.q3)
                  td
                    strong= money(prod.all.q4)
                  td
                    strong= money(prod.all.total)
              else
                tr
                  td
                    strong= prod.all.name
                  td
                    strong= money(prod.all.total)

block script
  script.
    (function () {
      var select = document.getElementById("periodType");
      if (!select) return;
      var boxes = {
        date: document.getElementById("period-date"),
        quarter: document.getElementById("period-quarter"),
        year: document.getElementById("period-year"),
      };
      var yearOnly = document.getElementById("yearOnly");
      var quarterYear = document.querySelector('#period-quarter input[name="year"]');

      function setDisabled(box, disabled) {
        if (!box) return;
        box.querySelectorAll("input, select").forEach(function (el) {
          el.disabled = disabled;
        });
      }

      function sync() {
        var type = select.value || "date";
        Object.keys(boxes).forEach(function (key) {
          if (!boxes[key]) return;
          var on = key === type;
          boxes[key].classList.toggle("is-on", on);
          setDisabled(boxes[key], !on);
        });
        if (yearOnly) {
          if (type === "year") {
            yearOnly.setAttribute("name", "year");
            if (quarterYear) quarterYear.removeAttribute("name");
          } else {
            yearOnly.removeAttribute("name");
            if (quarterYear) quarterYear.setAttribute("name", "year");
          }
        }
      }
      select.addEventListener("change", sync);
      sync();
    })();
