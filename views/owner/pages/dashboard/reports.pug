extends ../../layouts/default.pug

block head
  link(rel="stylesheet" href="/admin/css/drinks.css")
  link(rel="stylesheet" href="/admin/css/drink-index.css")
  link(rel="stylesheet" href="/admin/css/dashboard-bookings.css")
  style.
    .rp-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .rp-hero h1 { margin-bottom: 4px; }
    .rp-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .rp-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 12px;
      padding: 11px 16px;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      border: 1px solid transparent;
      transition: .15s ease;
      line-height: 1.2;
    }
    .rp-btn i { font-size: 16px; }
    .rp-btn-primary {
      background: #0f172a;
      color: #fff;
      box-shadow: 0 8px 18px rgba(15, 23, 42, .18);
    }
    .rp-btn-primary:hover { background: #1e293b; color: #fff; }
    .rp-btn-outline {
      background: #fff;
      color: #0f172a;
      border-color: #cbd5e1;
    }
    .rp-btn-outline:hover {
      border-color: #0f766e;
      color: #0f766e;
      background: #f0fdfa;
    }
    .rp-btn-soft {
      background: #ecfdf5;
      color: #0f766e;
      border-color: #99f6e4;
    }
    .rp-btn-soft:hover { background: #ccfbf1; color: #115e59; }
    .rp-stat {
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 16px 18px;
      background: linear-gradient(180deg, #fff 0%, #f8fafc 100%);
      height: 100%;
    }
    .rp-stat-label {
      display: block;
      color: #64748b;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .rp-stat-value {
      font-size: 1.45rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
    }
    .rp-stat.is-profit .rp-stat-value { color: #0f766e; }
    .rp-panel {
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      background: #fff;
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .04);
    }
    .rp-panel-title {
      font-size: 13px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 12px;
    }
    .rp-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }
    .rp-grid-2 {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 12px;
    }
    .rp-field label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #64748b;
      margin-bottom: 6px;
    }
    .rp-field .sz-input,
    .rp-field select.sz-input {
      width: 100%;
      max-width: none;
    }
    .rp-advanced {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px dashed #e2e8f0;
    }
    .rp-ops {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-top: 8px;
    }
    .rp-ops select,
    .rp-ops input { max-width: 150px; }
    .rp-ops-label {
      min-width: 84px;
      font-size: 13px;
      font-weight: 700;
      color: #334155;
    }
    .rp-note { font-size: 12px; color: #64748b; }
    .rp-import {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-top: 14px;
      padding: 12px;
      border-radius: 12px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
    }
    .rp-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }
    .rp-tab {
      display: inline-flex;
      align-items: center;
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #475569;
      font-weight: 700;
      font-size: 13px;
      text-decoration: none;
    }
    .rp-tab:hover { border-color: #99f6e4; color: #0f766e; }
    .rp-tab.active {
      background: #0f766e;
      border-color: #0f766e;
      color: #fff;
      box-shadow: 0 8px 16px rgba(15, 118, 110, .22);
    }
    .rp-detail {
      background: #f8fafc;
      border-radius: 14px;
      padding: 16px;
      min-height: 200px;
      border: 1px solid #e2e8f0;
    }
    .rp-row.active { outline: 2px solid #14b8a6; background: #f0fdfa; }
    .rp-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 999px;
      background: #ecfdf5;
      color: #0f766e;
      font-size: 11px;
      font-weight: 700;
      margin-right: 4px;
    }
    .rp-table td, .rp-table th { white-space: nowrap; }
    @media (max-width: 992px) {
      .rp-grid, .rp-grid-2 { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .rp-grid, .rp-grid-2 { grid-template-columns: 1fr; }
    }

block main
  - const f = typeof filter !== "undefined" ? filter : {}
  - const s = typeof summary !== "undefined" ? summary : { invoiceCount: 0, revenueText: "0đ", expenseText: "0đ", profitText: "0đ" }
  - const list = typeof invoices !== "undefined" ? invoices : []
  - const qm = typeof quarterMatrix !== "undefined" ? quarterMatrix : { year: f.year, thu: {}, chi: {}, profit: {} }
  - const staff = typeof staffStats !== "undefined" ? staffStats : { years: [], rows: [], all: { years: {}, total: 0, name: "TẤT CẢ" } }
  - const cust = typeof customerStats !== "undefined" ? customerStats : { years: [], rows: [], all: { years: {}, total: 0, name: "TẤT CẢ" } }
  - const prod = typeof productStats !== "undefined" ? productStats : { year: f.year, rows: [], all: { q1:0,q2:0,q3:0,q4:0,total:0,name:"Tất cả" } }
  - const money = (n) => `${Number(n || 0).toLocaleString("vi-VN")}đ`
  - const qs = (o = {}) => { const p = Object.assign({}, f, o); return Object.keys(p).filter((k) => p[k] !== undefined && p[k] !== "").map((k) => k + "=" + encodeURIComponent(p[k])).join("&"); }
  - const tab = f.tab || "overview"

  .rp-hero
    div
      h1.sz-title Báo cáo tài chính
      p.sz-subtitle Lọc nâng cao · duyệt hóa đơn · thống kê quý/năm · xuất Excel/PDF
    .rp-actions
      a.rp-btn.rp-btn-primary(href=`${prefixOwner}/dashboard/reports/export.xlsx?${qs()}`)
        i.bi.bi-file-earmark-excel
        span Xuất Excel
      a.rp-btn.rp-btn-outline(href=`${prefixOwner}/dashboard/reports/export.pdf?${qs()}`)
        i.bi.bi-file-earmark-pdf
        span Xuất PDF

  .row.g-3.mb-3
    .col-12.col-md-3
      .rp-stat
        span.rp-stat-label Số hóa đơn
        .rp-stat-value= s.invoiceCount
    .col-12.col-md-3
      .rp-stat
        span.rp-stat-label Tổng thu
        .rp-stat-value= s.revenueText
    .col-12.col-md-3
      .rp-stat
        span.rp-stat-label Tổng chi
        .rp-stat-value= s.expenseText
    .col-12.col-md-3
      .rp-stat.is-profit
        span.rp-stat-label Lợi nhuận
        .rp-stat-value= s.profitText

  .rp-panel
    .rp-panel-title Bộ lọc báo cáo
    form#report-filter(method="GET" action=`${prefixOwner}/dashboard/reports`)
      input(type="hidden" name="tab" value=tab)
      .rp-grid
        .rp-field
          label Cơ sở
          select.sz-input(name="venueId")
            option(value="") Tất cả cơ sở
            each v in (venues || [])
              option(value=v._id selected=(String(f.venueId) === String(v._id)))= v.name
        .rp-field
          label Từ ngày
          input.sz-input(type="date" name="dateFrom" value=f.dateFrom)
        .rp-field
          label Đến ngày
          input.sz-input(type="date" name="dateTo" value=f.dateTo)
        .rp-field
          label Năm thống kê
          input.sz-input(type="number" name="year" value=f.year min="2020" max="2100")
      .rp-grid-2
        .rp-field
          label Tìm kiếm
          .sz-search
            i.bi.bi-search
            input#report-q.sz-input(type="search" name="q" placeholder="Mã HĐ, khách, sân..." value=f.q autocomplete="off")
        .rp-field
          label Loại voucher
          select.sz-input(name="voucherScope")
            each vs in (voucherScopes || [])
              option(value=vs.value selected=(String(f.voucherScope || "") === String(vs.value)))= vs.label
      .d-flex.flex-wrap.gap-2.mt-3
        button.rp-btn.rp-btn-primary(type="submit")
          i.bi.bi-funnel
          span Áp dụng lọc
        a.rp-btn.rp-btn-soft(href=`${prefixOwner}/dashboard/reports`) Xóa lọc

      .rp-advanced
        .rp-note.mb-1 Tìm kiếm nâng cao — toán tử so sánh &amp; logic And/Or
        .rp-ops
          span.rp-ops-label Tổng tiền
          select.sz-input(name="amountOp")
            option(value="") —
            each op in (ops || [])
              option(value=op.value selected=(f.amountOp === op.value))= op.label
          input.sz-input(type="number" name="amountValue" placeholder="VD 1000000" value=(f.amountValue === "" ? "" : f.amountValue))
          select.sz-input(name="amountLogic")
            option(value="and" selected=(f.amountLogic !== "or")) And
            option(value="or" selected=(f.amountLogic === "or")) Or
          select.sz-input(name="amountOp2")
            option(value="") —
            each op in (ops || [])
              option(value=op.value selected=(f.amountOp2 === op.value))= op.label
          input.sz-input(type="number" name="amountValue2" placeholder="VD 2000000" value=(f.amountValue2 === "" ? "" : f.amountValue2))
        .rp-ops
          span.rp-ops-label Khách hàng
          input.sz-input(type="text" name="customerA" placeholder="VD tên / khu vực" value=f.customerA)
          select.sz-input(name="customerLogic")
            option(value="or" selected=(f.customerLogic !== "and")) Or
            option(value="and" selected=(f.customerLogic === "and")) And
          input.sz-input(type="text" name="customerB" placeholder="VD tên / khu vực 2" value=f.customerB)

    form.rp-import(method="POST" action=`${prefixOwner}/dashboard/reports/import` enctype="multipart/form-data")
      i.bi.bi-file-earmark-arrow-up
      span.rp-note Xem trước file Excel để đối chiếu
      input(type="file" name="file" accept=".xlsx,.xls" required)
      button.rp-btn.rp-btn-outline(type="submit") Đọc file Excel

  .rp-tabs
    a.rp-tab(href=`?${qs({ tab: "overview" })}` class=(tab === "overview" ? "active" : undefined)) Tổng hợp quý
    a.rp-tab(href=`?${qs({ tab: "invoices" })}` class=(tab === "invoices" ? "active" : undefined)) Duyệt hóa đơn
    a.rp-tab(href=`?${qs({ tab: "staff" })}` class=(tab === "staff" ? "active" : undefined)) Theo nhân viên
    a.rp-tab(href=`?${qs({ tab: "customers" })}` class=(tab === "customers" ? "active" : undefined)) Theo khách hàng
    a.rp-tab(href=`?${qs({ tab: "products" })}` class=(tab === "products" ? "active" : undefined)) Theo sản phẩm

  if tab === "overview"
    .rp-panel
      h2.sz-title(style="font-size:1.15rem;margin-bottom:12px") Thu / chi / lợi nhuận năm #{qm.year}
      .sz-table-wrap
        table.sz-table.rp-table
          thead
            tr
              th #{qm.year}
              th Q1
              th Q2
              th Q3
              th Q4
              th Tổng
          tbody
            tr
              td= qm.thu.label
              td= money(qm.thu.q1)
              td= money(qm.thu.q2)
              td= money(qm.thu.q3)
              td= money(qm.thu.q4)
              td
                strong= money(qm.thu.total)
            tr
              td= qm.chi.label
              td= money(qm.chi.q1)
              td= money(qm.chi.q2)
              td= money(qm.chi.q3)
              td= money(qm.chi.q4)
              td
                strong= money(qm.chi.total)
            tr
              td
                strong= qm.profit.label
              td
                strong= money(qm.profit.q1)
              td
                strong= money(qm.profit.q2)
              td
                strong= money(qm.profit.q3)
              td
                strong= money(qm.profit.q4)
              td
                strong= money(qm.profit.total)

  else if tab === "invoices"
    .rp-panel
      h2.sz-title(style="font-size:1.15rem;margin-bottom:12px") Danh sách hóa đơn
      if list.length
        .sz-table-wrap
          table.sz-table.db-bookings-table#report-invoice-table
            thead
              tr
                th MaHD
                th Loại
                th Ngày
                th.db-col-fold Khách / Voucher
                th Tổng tiền
                th.db-col-action
                th.db-detail-head Chi tiết hóa đơn
            tbody
              each inv, index in list
                tr.db-row.rp-row(class=(selected && selected.code === inv.code ? "active" : undefined) data-code=inv.code tabindex="0")
                  td
                    strong= inv.code
                  td= inv.typeLabel
                  td= inv.date
                  td.db-col-fold
                    div= inv.customer
                    .sz-muted= inv.phone
                    if inv.vouchers && inv.vouchers.length
                      .mt-1
                        each v in inv.vouchers
                          span.rp-chip #{v.scopeLabel}: #{v.code}
                  td
                    strong.sz-price= inv.amountText
                  td.db-col-action
                    a.db-view-btn(href=`?${qs({ tab: "invoices", selectedCode: inv.code })}`) Xem
                  if index === 0
                    td.db-detail-cell(rowspan=list.length)
                      .rp-detail#invoice-detail
                        if selected
                          h3.mb-2= selected.code
                          p.sz-muted #{selected.typeLabel} · #{selected.date} · #{selected.venue}
                          p Khách: #{selected.customer} #{selected.phone ? "(" + selected.phone + ")" : ""}
                          p NV: #{selected.staffName}
                          if selected.vouchers && selected.vouchers.length
                            p
                              | Voucher:
                              each v in selected.vouchers
                                span.rp-chip #{v.scopeLabel}: #{v.code}
                            if selected.discount
                              p Giảm giá: 
                                strong= selected.discountText
                          hr
                          each line in selected.lines
                            .d-flex.justify-content-between.mb-1
                              span #{line.name} × #{line.qty}
                              strong= money(line.lineTotal)
                          hr
                          .d-flex.justify-content-between
                            strong Tổng
                            strong.sz-price= selected.amountText
                        else
                          .sz-empty
                            p Chọn một hóa đơn để xem chi tiết
      else
        .sz-empty
          i.bi.bi-receipt
          h3 Không có hóa đơn
          p Thử đổi khoảng ngày hoặc bỏ điều kiện lọc nâng cao.

  else if tab === "staff"
    .rp-panel
      h2.sz-title(style="font-size:1.15rem;margin-bottom:12px") Thống kê theo nhân viên &amp; năm
      .sz-table-wrap
        table.sz-table.rp-table
          thead
            tr
              th NV
              each y in staff.years
                th= y
              th TỔNG
          tbody
            each row in staff.rows
              tr
                td= row.name
                each y in staff.years
                  td= money(row.years[y])
                td
                  strong= money(row.total)
            tr
              td
                strong= staff.all.name
              each y in staff.years
                td
                  strong= money(staff.all.years[y])
              td
                strong= money(staff.all.total)

  else if tab === "customers"
    .rp-panel
      h2.sz-title(style="font-size:1.15rem;margin-bottom:12px") Thống kê theo khách hàng &amp; năm
      .sz-table-wrap
        table.sz-table.rp-table
          thead
            tr
              th Khách hàng
              th SĐT
              each y in cust.years
                th= y
              th TỔNG
          tbody
            each row in cust.rows
              tr
                td= row.name
                td= row.phone || "—"
                each y in cust.years
                  td= money(row.years[y])
                td
                  strong= money(row.total)
            tr
              td(colspan="2")
                strong= cust.all.name
              each y in cust.years
                td
                  strong= money(cust.all.years[y])
              td
                strong= money(cust.all.total)

  else if tab === "products"
    .rp-panel
      h2.sz-title(style="font-size:1.15rem;margin-bottom:8px") Thống kê theo sản phẩm · quý #{prod.year}
      p.rp-note.mb-3 Bảng này dùng để lập kế hoạch kinh doanh năm sau.
      .sz-table-wrap
        table.sz-table.rp-table
          thead
            tr
              th Sản phẩm
              th Q1
              th Q2
              th Q3
              th Q4
              th TỔNG
          tbody
            each row in prod.rows
              tr
                td= row.name
                td= money(row.q1)
                td= money(row.q2)
                td= money(row.q3)
                td= money(row.q4)
                td
                  strong= money(row.total)
            tr
              td
                strong= prod.all.name
              td
                strong= money(prod.all.q1)
              td
                strong= money(prod.all.q2)
              td
                strong= money(prod.all.q3)
              td
                strong= money(prod.all.q4)
              td
                strong= money(prod.all.total)

block script
  script.
    (function () {
      var input = document.getElementById("report-q");
      var form = document.getElementById("report-filter");
      if (!input || !form) return;
      var timer = null;
      input.addEventListener("input", function () {
        clearTimeout(timer);
        timer = setTimeout(function () {
          form.requestSubmit ? form.requestSubmit() : form.submit();
        }, 450);
      });
    })();
