extends ../../layouts/default.pug
include ../../../mixins/alert.pug

block head
  link(rel="stylesheet" href="/admin/css/bookings.css")

block main
  +alert-success(5000)
  +alert-error(5000)
  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3.mb-4
    div
      h1.sz-title Quản lý Đặt sân & Lịch thi đấu
      p.sz-subtitle Đặt tại chỗ ngay trên sơ đồ: chọn các ô giờ liền nhau của cùng một sân.
    .d-flex.gap-2.flex-wrap
      button#openWalkIn.sz-btn.sz-btn-dark(type="button" disabled=!walkIn.allowed)
        i.bi.bi-plus-lg
        | Đặt tại chỗ

  .sz-card.sz-filter-bar.mb-3
    .row.g-2.align-items-center
      .col-12.col-md-3
        label.sz-label(for="bookingDate") Ngày xem
        input#bookingDate.sz-input(
          type="date"
          value=dateValue
          min=dateMin
          max=dateMax
          onchange="if (this.value) window.location.search = '?date=' + this.value"
        )

  .sz-card.sz-panel
    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3
      h2.sz-panel-title Sơ đồ phân bổ khung giờ các sân ngày: #{dateLabel}
      .sz-status-legend
        span
          i.dot.is-paid
          | Đã đặt lịch
        span
          i.dot.is-done
          | Đã thanh toán
        span
          i.dot.is-pick
          | Đang chọn

    #pickBar.sz-pick-bar(data-allowed=(walkIn.allowed ? "true" : "false") data-reason=walkIn.reason || "")
      div
        strong#pickTitle.sz-pick-title Chọn ô giờ trên sơ đồ
        p#pickHint.sz-pick-hint(aria-live="polite") Bấm các ô trống liền nhau trên cùng một sân. 08 → 09 → 10 được, 08 → 10 thì không.
      .sz-pick-actions
        button#pickClear.sz-pick-clear(type="button") Bỏ chọn
        button#pickBook.sz-btn.sz-btn-green.sz-pick-book(type="button" disabled) Đặt các giờ đã chọn

    .sz-timeline-wrap
      .sz-timeline
        .sz-timeline-head
          .sz-timeline-court-col Sân
          each h in hours
            .sz-timeline-hour #{h}:00
        each row in rows
          - const courtLabel = row.venue ? row.venue + " — " + row.name : row.name
          .sz-timeline-row(class=(row.status === "maintenance" ? "is-maint" : ""))
            .sz-timeline-court-col
              strong= row.name
              if row.venue
                small.sz-court-venue= row.venue
              if row.status === "open"
                small.sz-open Đang mở
              else if row.status === "empty"
                small.sz-court-venue Chưa có sân
              else
                small.sz-maint
                  i.bi.bi-exclamation-triangle
                  |  Đang bảo trì
            each h in hours
              - const slot = row.slots[h]
              - const canPick = !slot && row.status === "open" && row.id && walkIn.allowed && (h + ":00") >= walkIn.startMin
              - const hourEnd = String(Number(h) + 1).padStart(2, "0")
              .sz-timeline-cell(class=canPick ? "is-free" : (!slot ? "is-closed" : undefined) title=(!canPick && !slot && row.status === "open" && walkIn.allowed ? "Đã qua giờ" : undefined))
                if slot
                  button.sz-slot(
                    type="button"
                    class=(slot.status === "completed" ? "is-done" : undefined)
                    data-code=slot.id
                    data-status=slot.status
                    data-customer=slot.name
                    data-phone=slot.phone
                    data-court=slot.court
                    data-time=slot.time
                    data-amount=slot.amount
                  )
                    span= slot.name
                    small(title=slot.id)= slot.shortId
                else if canPick
                  button.sz-hour-pick(
                    type="button"
                    data-court=row.id
                    data-label=courtLabel
                    data-hour=h
                    aria-pressed="false"
                    aria-label=`Chọn ${h}:00 đến ${hourEnd}:00, ${courtLabel}`
                  )
                    i.bi.bi-plus-lg
                    i.bi.bi-check-lg

  #bookingModal.bk-modal(aria-hidden="true")
    .bk-modal-backdrop(data-close="true")
    .bk-modal-card(role="dialog" aria-modal="true" aria-labelledby="bookingModalTitle")
      button.bk-modal-close(type="button" data-close="true" aria-label="Đóng")
        i.bi.bi-x-lg
      p.bk-modal-code(data-field="code")
      h3#bookingModalTitle.bk-modal-title Chi tiết Đơn đặt sân
      .bk-modal-sheet
        .bk-modal-row
          span Khách hàng:
          strong(data-field="customer")
        .bk-modal-row
          span Số điện thoại:
          strong(data-field="phone")
        .bk-modal-row
          span Sân đặt:
          strong(data-field="court")
        .bk-modal-row
          span Thời gian:
          strong(data-field="time")
        .bk-modal-row
          span Tổng tiền:
          strong.bk-modal-amount(data-field="amount")
      form#checkInForm(action=`${prefixOwner}/bookings/check-in` method="POST")
        input(type="hidden" name="code")
        input(type="hidden" name="date" value=dateValue)
        button.sz-btn.sz-btn-green.bk-modal-action(type="submit")
          i.bi.bi-check-circle
          | Xác nhận Check-in cho khách vào sân
      form#cancelForm(action=`${prefixOwner}/bookings/cancel` method="POST")
        input(type="hidden" name="code")
        input(type="hidden" name="date" value=dateValue)
        button.sz-btn.sz-btn-outline-danger.bk-modal-action(type="submit")
          | Hủy đơn & Hoàn slot

  #walkInModal.bk-modal(aria-hidden="true")
    .bk-modal-backdrop(data-close-walkin="true")
    .bk-modal-card.bk-walkin-card(role="dialog" aria-modal="true" aria-labelledby="walkInTitle")
      button.bk-modal-close(type="button" data-close-walkin="true" aria-label="Đóng")
        i.bi.bi-x-lg
      h3#walkInTitle.bk-walkin-title Đặt các giờ đã chọn
      if !walkIn.allowed
        p.bk-walkin-hint.is-warn= walkIn.reason
      form#walkInForm(action=`${prefixOwner}/bookings/create` method="POST")
        input(type="hidden" name="date" value=dateValue)
        input#walkInCourt(type="hidden" name="court")
        input#walkInStart(type="hidden" name="timeStart")
        input#walkInEnd(type="hidden" name="timeEnd")
        p#walkInSummary.bk-walkin-summary Chọn ô giờ trên sơ đồ trước khi đặt.
        .bk-walkin-grid
          .bk-walkin-field
            label.bk-walkin-label(for="walkInName") Tên khách
            input#walkInName.bk-walkin-input(type="text" name="customer" required placeholder="Nguyễn Trần Hoàng Phúc")
          .bk-walkin-field
            label.bk-walkin-label(for="walkInPhone") Số điện thoại
            input#walkInPhone.bk-walkin-input(type="tel" name="phone" required placeholder="0900 123 456")
        .bk-walkin-grid
          .bk-walkin-field
            label.bk-walkin-label(for="walkInAmount") Tiền thu (VND)
            input#walkInAmount.bk-walkin-input(type="number" name="amount" required min="0" step="1" readonly placeholder="Chọn ô giờ trên sơ đồ")
            p#walkInPriceHint.bk-walkin-hint
          .bk-walkin-field
            label.bk-walkin-label(for="walkInPay") Hình thức
            select#walkInPay.bk-walkin-input(name="paymentMethod")
              option(value="cash") Tiền mặt tại quầy
              option(value="vnpay") Chuyển khoản QR
        .bk-walkin-foot
          button.bk-walkin-cancel(type="button" data-close-walkin="true") Hủy
          button.sz-btn.sz-btn-green.bk-walkin-submit(type="submit" disabled=!walkIn.allowed) Xác nhận đặt sân

block script
  script#walkInPriceRules(type="application/json")!= JSON.stringify(priceRules || [])
  script(src="/admin/js/bookings.js")
