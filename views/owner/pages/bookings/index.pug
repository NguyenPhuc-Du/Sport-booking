extends ../../layouts/default.pug

block head
  link(rel="stylesheet" href="/admin/css/bookings.css")

block main
  .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3.mb-4
    div
      h1.sz-title Quản lý Đặt sân & Lịch thi đấu
      p.sz-subtitle Theo dõi sơ đồ timeline theo giờ, check-in QR và đặt tại chỗ cho từng sân.
    .d-flex.gap-2.flex-wrap
      button#openWalkIn.sz-btn.sz-btn-dark(type="button")
        i.bi.bi-plus-lg
        | Đặt tại chỗ

  .sz-card.sz-filter-bar.mb-3
    .row.g-2.align-items-center
      .col-12.col-md-3
        label.sz-label(for="bookingDate") Ngày xem
        input#bookingDate.sz-input(
          type="date"
          value=dateValue
          min=dateMin
          max=dateMax
          onchange="if (this.value) window.location.search = '?date=' + this.value"
        )

  .sz-card.sz-panel
    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3
      h2.sz-panel-title Sơ đồ phân bổ khung giờ các sân ngày: #{dateLabel}
      .sz-status-legend
        span
          i.dot.is-paid
          | Đã thanh toán
        span
          i.dot.is-pending
          | Chờ duyệt / cọc
        span
          i.dot.is-done
          | Hoàn thành

    .sz-timeline-wrap
      .sz-timeline
        .sz-timeline-head
          .sz-timeline-court-col Sân
          each h in hours
            .sz-timeline-hour #{h}:00
        each row in rows
          .sz-timeline-row(class=(row.status === "maintenance" ? "is-maint" : ""))
            .sz-timeline-court-col
              strong= row.name
              if row.venue
                small.sz-court-venue= row.venue
              if row.status === "open"
                small.sz-open Đang mở
              else if row.status === "empty"
                small.sz-court-venue Chưa có sân
              else
                small.sz-maint
                  i.bi.bi-exclamation-triangle
                  |  Đang bảo trì
            each h in hours
              - const slot = row.slots[h]
              .sz-timeline-cell
                if slot
                  button.sz-slot(
                    type="button"
                    class=(slot.status === "completed" ? "is-done" : undefined)
                    data-code=slot.id
                    data-status=slot.status
                    data-customer=slot.name
                    data-phone=slot.phone
                    data-court=slot.court
                    data-time=slot.time
                    data-amount=slot.amount
                  )
                    span= slot.name
                    small #{slot.id}

  #bookingModal.bk-modal(aria-hidden="true")
    .bk-modal-backdrop(data-close="true")
    .bk-modal-card(role="dialog" aria-modal="true" aria-labelledby="bookingModalTitle")
      button.bk-modal-close(type="button" data-close="true" aria-label="Đóng")
        i.bi.bi-x-lg
      p.bk-modal-code(data-field="code")
      h3#bookingModalTitle.bk-modal-title Chi tiết Đơn đặt sân
      .bk-modal-sheet
        .bk-modal-row
          span Khách hàng:
          strong(data-field="customer")
        .bk-modal-row
          span Số điện thoại:
          strong(data-field="phone")
        .bk-modal-row
          span Sân đặt:
          strong(data-field="court")
        .bk-modal-row
          span Thời gian:
          strong(data-field="time")
        .bk-modal-row
          span Tổng tiền:
          strong.bk-modal-amount(data-field="amount")
      form#checkInForm(action=`${prefixOwner}/bookings/check-in` method="POST")
        input(type="hidden" name="code")
        input(type="hidden" name="date" value=dateValue)
        button.sz-btn.sz-btn-green.bk-modal-action(type="submit")
          i.bi.bi-check-circle
          | Xác nhận Check-in cho khách vào sân
      form#cancelForm(action=`${prefixOwner}/bookings/cancel` method="POST")
        input(type="hidden" name="code")
        input(type="hidden" name="date" value=dateValue)
        button.sz-btn.sz-btn-outline-danger.bk-modal-action(type="submit")
          | Hủy đơn & Hoàn slot

  #walkInModal.bk-modal(aria-hidden="true")
    .bk-modal-backdrop(data-close-walkin="true")
    .bk-modal-card.bk-walkin-card(role="dialog" aria-modal="true" aria-labelledby="walkInTitle")
      button.bk-modal-close(type="button" data-close-walkin="true" aria-label="Đóng")
        i.bi.bi-x-lg
      h3#walkInTitle.bk-walkin-title Đặt lịch tại quầy (Khách vãng lai)
      form#walkInForm(onsubmit="return false")
        .bk-walkin-field
          label.bk-walkin-label(for="walkInCourt") Chọn sân thi đấu
          select#walkInCourt.bk-walkin-input(name="court")
            option(value="" selected) Chọn sân
            each row in rows
              if row.status === "open"
                option(value=row.name)= row.venue ? `${row.venue} — ${row.name}` : row.name
        .bk-walkin-grid
          .bk-walkin-field
            label.bk-walkin-label(for="walkInName") Tên khách
            input#walkInName.bk-walkin-input(type="text" name="customer" placeholder="Khách vãng lai")
          .bk-walkin-field
            label.bk-walkin-label(for="walkInPhone") Số điện thoại
            input#walkInPhone.bk-walkin-input(type="tel" name="phone" placeholder="0900 123 456")
        .bk-walkin-grid
          .bk-walkin-field
            label.bk-walkin-label(for="walkInStart") Từ giờ
            input#walkInStart.bk-walkin-input(type="time" name="timeStart" min="06:00" max="21:00" step="3600")
          .bk-walkin-field
            label.bk-walkin-label(for="walkInEnd") Đến giờ
            input#walkInEnd.bk-walkin-input(type="time" name="timeEnd" min="06:00" max="22:00" step="3600")
        .bk-walkin-grid
          .bk-walkin-field
            label.bk-walkin-label(for="walkInAmount") Tiền thu (VND)
            input#walkInAmount.bk-walkin-input(type="number" name="amount" min="0" step="1000" placeholder="180000")
          .bk-walkin-field
            label.bk-walkin-label(for="walkInPay") Hình thức
            select#walkInPay.bk-walkin-input(name="payment")
              option(value="cash") Tiền mặt tại quầy
        .bk-walkin-foot
          button.bk-walkin-cancel(type="button" data-close-walkin="true") Hủy
          button.sz-btn.sz-btn-green.bk-walkin-submit(type="button") Xác nhận đặt sân

block script
  script.
    (function () {
      var modal = document.getElementById("bookingModal");
      if (!modal) return;
      var fields = {};
      modal.querySelectorAll("[data-field]").forEach(function (el) {
        fields[el.getAttribute("data-field")] = el;
      });
      var lastFocus = null;
      var checkInForm = document.getElementById("checkInForm");
      var checkInCode = checkInForm.querySelector("[name=code]");
      var cancelCode = document.querySelector("#cancelForm [name=code]");

      function show(value) {
        return value ? value : "—";
      }

      function openModal(slot) {
        fields.code.textContent = show(slot.dataset.code);
        fields.customer.textContent = show(slot.dataset.customer);
        fields.phone.textContent = show(slot.dataset.phone);
        fields.court.textContent = show(slot.dataset.court);
        fields.time.textContent = show(slot.dataset.time);
        fields.amount.textContent = show(slot.dataset.amount);
        checkInCode.value = slot.dataset.code || "";
        cancelCode.value = slot.dataset.code || "";
        checkInForm.hidden = slot.dataset.status === "completed";
        lastFocus = document.activeElement;
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        lockBody();
        var closeBtn = modal.querySelector(".bk-modal-close");
        if (closeBtn) closeBtn.focus();
      }

      function lockBody() {
        var walkIn = document.getElementById("walkInModal");
        var open = modal.classList.contains("is-open") || (walkIn && walkIn.classList.contains("is-open"));
        document.body.classList.toggle("bk-modal-open", open);
      }

      function closeModal() {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        lockBody();
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      document.querySelectorAll(".sz-slot").forEach(function (slot) {
        slot.addEventListener("click", function () {
          openModal(slot);
        });
      });

      modal.querySelectorAll("[data-close]").forEach(function (el) {
        el.addEventListener("click", closeModal);
      });

      var walkIn = document.getElementById("walkInModal");
      var walkInForm = document.getElementById("walkInForm");
      var openWalkInBtn = document.getElementById("openWalkIn");

      function openWalkIn() {
        if (!walkIn) return;
        if (modal.classList.contains("is-open")) closeModal();
        walkIn.classList.add("is-open");
        walkIn.setAttribute("aria-hidden", "false");
        lockBody();
        var court = document.getElementById("walkInCourt");
        if (court) court.focus();
      }

      function closeWalkIn() {
        if (!walkIn) return;
        walkIn.classList.remove("is-open");
        walkIn.setAttribute("aria-hidden", "true");
        if (walkInForm) walkInForm.reset();
        lockBody();
        if (openWalkInBtn) openWalkInBtn.focus();
      }

      if (openWalkInBtn) openWalkInBtn.addEventListener("click", openWalkIn);
      if (walkIn) {
        walkIn.querySelectorAll("[data-close-walkin]").forEach(function (el) {
          el.addEventListener("click", closeWalkIn);
        });
      }

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape") return;
        if (walkIn && walkIn.classList.contains("is-open")) closeWalkIn();
        else if (modal.classList.contains("is-open")) closeModal();
      });
    })();
