aside.sz-sidebar
  if panelRole === "admin"
    .sz-facility
      .d-flex.justify-content-between.align-items-center
        small.sz-facility-label NỀN TẢNG SPORTZONE
        span.sz-dot-green(aria-hidden="true")
      .sz-facility-name Admin Console
      .sz-facility-plan
        i.bi.bi-shield-lock
        |  Quản trị hệ thống
    .sz-menu-title PHÂN HỆ QUẢN TRỊ
    nav.sz-menu(aria-label="Menu quản trị")
      a.sz-menu-item(href="/admin/dashboard" class=(activeMenu === "dashboard" ? "active" : undefined))
        i.bi.bi-grid
        span.sz-menu-text Tổng quan sàn
      a.sz-menu-item(href="/admin/users" class=(activeMenu === "users" ? "active" : undefined))
        i.bi.bi-people
        span.sz-menu-text Tài khoản
    .sz-sidebar-bottom
      .sz-copy Hệ thống SportZone 

  else
    .sz-facility
      .d-flex.justify-content-between.align-items-center
        small.sz-facility-label CƠ SỞ ĐANG QUẢN LÝ
        span.sz-dot-green(aria-hidden="true")
      .sz-facility-name SportPro Complex - Cầu Giấy

    .sz-menu-title PHÂN HỆ CHỦ SÂN
    nav.sz-menu(aria-label="Menu chủ sân")
      a.sz-menu-item(href=`${prefixAdmin}/dashboard` class={ active: activeMenu === "dashboard" })
        i.bi.bi-grid
        span.sz-menu-text Tổng quan & Thống kê
      a.sz-menu-item(href=`${prefixAdmin}/facilities` class={ active: activeMenu === "facilities" })
        i.bi.bi-buildings
        span.sz-menu-text Quản lý Cơ sở & Sân
      a.sz-menu-item(href=`${prefixAdmin}/bookings` class={ active: activeMenu === "bookings" })
        i.bi.bi-calendar-check
        span.sz-menu-text Lịch đặt & Sơ đồ Timeline
      a.sz-menu-item(href=`${prefixAdmin}/finance` class={ active: activeMenu === "finance" })
        i.bi.bi-credit-card-2-front
        span.sz-menu-text Tài chính & Khuyến mãi
      a.sz-menu-item(href=`${prefixAdmin}/drinks` class={ active: activeMenu === "drinks" })
        i.bi.bi-cup-straw
        span.sz-menu-text Dịch vụ giải khát
      a.sz-menu-item(href=`${prefixAdmin}/profile` class={ active: activeMenu === "profile" })
        i.bi.bi-person-badge
        span.sz-menu-text Hồ sơ & Avatar

    .sz-sidebar-bottom
      .sz-copy Hệ thống SportZone 
