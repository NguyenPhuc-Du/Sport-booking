aside.sz-sidebar
  .sz-facility
    .d-flex.justify-content-between.align-items-center
      small.sz-facility-label CƠ SỞ ĐANG QUẢN LÝ
      span.sz-dot-green(aria-hidden="true")
    .sz-facility-name= sidebarVenueName || "Cơ sở của bạn"
    if sidebarVenueExtra
      .sz-facility-plan= sidebarVenueExtra

  .sz-menu-title PHÂN HỆ CHỦ SÂN
  nav.sz-menu(aria-label="Menu chủ sân")
    a.sz-menu-item(href=`${prefixOwner}/dashboard` class={ active: activeMenu === "dashboard" })
      i.bi.bi-grid
      span.sz-menu-text Tổng quan & Thống kê
    a.sz-menu-item(href=`${prefixOwner}/dashboard/reports` class={ active: activeMenu === "reports" })
      i.bi.bi-clipboard-data
      span.sz-menu-text Báo cáo tài chính
    a.sz-menu-item(href=`${prefixOwner}/facilities` class={ active: activeMenu === "facilities" })
      i.bi.bi-buildings
      span.sz-menu-text Quản lý Cơ sở & Sân
    a.sz-menu-item(href=`${prefixOwner}/bookings` class={ active: activeMenu === "bookings" })
      i.bi.bi-calendar-check
      span.sz-menu-text Lịch đặt & Sơ đồ Timeline
    a.sz-menu-item(href=`${prefixOwner}/bookings/list` class={ active: activeMenu === "booking-list" })
      i.bi.bi-list-ul
      span.sz-menu-text Danh sách đặt sân
    a.sz-menu-item(href=`${prefixOwner}/finance` class={ active: activeMenu === "finance" })
      i.bi.bi-credit-card-2-front
      span.sz-menu-text Tài chính & Khuyến mãi
    a.sz-menu-item(href=`${prefixOwner}/drinks` class={ active: activeMenu === "drinks" })
      i.bi.bi-cup-straw
      span.sz-menu-text Dịch vụ giải khát
    a.sz-menu-item(href=`${prefixOwner}/reviews` class={ active: activeMenu === "reviews" })
      i.bi.bi-star-half
      span.sz-menu-text Đánh giá & Phản hồi
    a.sz-menu-item(href=`${prefixOwner}/profile` class={ active: activeMenu === "profile" })
      i.bi.bi-person-badge
      span.sz-menu-text Hồ sơ & Avatar

  .sz-sidebar-bottom
    .sz-copy SportZone Owner
