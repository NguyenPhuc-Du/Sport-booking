header.sz-header
  .sz-header-inner
    .d-flex.align-items-center.gap-4.flex-wrap
      a.sz-brand(href=panelHome || "/owner/dashboard")
        span
          span.sz-brand-name Sport
            span.text-green Zone
          small.sz-brand-sub Hệ thống Đặt & Quản lý Sân

    .d-flex.align-items-center.gap-3.gap-lg-4
      .sz-role-pill
        span.dot
        | Chủ sân
      - const ownerName = user && user.fullName ? user.fullName : "Chu san"
      - const ownerAvatar = (user && user.avatar_url) || ("https://ui-avatars.com/api/?name=" + encodeURIComponent(ownerName) + "&background=0f766e&color=fff")
      a.sz-user(href=`${prefixOwner}/profile`)
        img(src=ownerAvatar alt="Avatar chủ sân")
        div
          .sz-user-name= user && user.fullName ? user.fullName : "Chủ sân"
      a.sz-logout(href="/auth/logout")
        i.bi.bi-box-arrow-right
        span Đăng xuất
