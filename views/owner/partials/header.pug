header.sz-header
  .sz-header-inner
    .d-flex.align-items-center.gap-4.flex-wrap
      a.sz-brand(href=panelHome || "/owner/dashboard")
        span
          span.sz-brand-name Sport
            span.text-green Zone
          small.sz-brand-sub Hệ thống Đặt & Quản lý Sân

    .d-flex.align-items-center.gap-3.gap-lg-4
      if panelRole === "admin"
        .sz-role-pill
          span.dot
          | Super Admin
        .sz-user
          div
            .sz-user-name= user && user.fullName ? user.fullName : "Quản trị"
            .sz-user-sub Quản trị hệ thống
        a.pf-logout(href="/admin/auth/logout") Thoát  
      else
        .sz-role-pill
          span.dot
          | Chủ sân
        a.sz-user(href="/owner/profile")
          img(src=user.avatar_url alt="Avatar chủ sân")
          div
            .sz-user-name #{user.fullName}
        a.sz-logout(href="/auth/logout")
          i.bi.bi-box-arrow-right
          span Đăng xuất
